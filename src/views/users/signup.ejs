<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <img src="/images/svg/logo.svg" alt="Audify" class="auth-logo" />
      <h1 class="auth-title">Create your account</h1>
      <p class="auth-subtitle">Join Audify for premium sound experiences</p>
    </div>

    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
      <div class="alert alert-danger border-0 rounded-4 mb-4 py-2 px-3" role="alert">
        <ul class="mb-0 ps-3">
          <% errors.forEach(error => { %>
            <li class="small"><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="auth-social">
      <button type="button" class="btn-social w-100" onclick="window.location.href='/auth/google';">
        <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" alt="Google" />
        Continue with Google
      </button>
    </div>

    <div class="auth-divider">or</div>

    <form id="signupForm" action="/signup" method="POST">
      <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6">
          <label class="form-label ms-1">First Name</label>
          <input
            type="text"
            class="form-control form-control-modern"
            id="firstname"
            name="firstName"
            placeholder="John"
            value="<%= typeof formData !== 'undefined' && formData ? (formData.firstName || '') : '' %>"
          />
          <div id="firstnameError" class="text-danger small mt-1 ms-1" style="display: none;"></div>
        </div>
        <div class="col-12 col-sm-6">
          <label class="form-label ms-1">Last Name</label>
          <input
            type="text"
            class="form-control form-control-modern"
            id="lastname"
            name="lastName"
            placeholder="Doe"
            value="<%= typeof formData !== 'undefined' && formData ? (formData.lastName || '') : '' %>"
          />
          <div id="lastnameError" class="text-danger small mt-1 ms-1" style="display: none;"></div>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label ms-1">Email</label>
        <input
          type="text"
          class="form-control form-control-modern"
          id="email"
          name="email"
          placeholder="you@example.com"
          value="<%= typeof formData !== 'undefined' && formData ? (formData.email || '') : '' %>"
        />
        <div id="emailError" class="text-danger small mt-1 ms-1" style="display: none;"></div>
      </div>
      <div class="mb-3">
        <label class="form-label ms-1">Password</label>
        <div class="position-relative">
          <input
            type="password"
            class="form-control form-control-modern"
            id="password"
            name="password"
            placeholder="Min. 8 characters"
          />
          <button type="button" id="togglePassword" class="btn position-absolute top-50 end-0 translate-middle-y border-0 bg-transparent pe-3">
            <i class="far fa-eye text-muted" id="eyeIcon"></i>
          </button>
        </div>
        <div id="passwordError" class="text-danger small mt-1 ms-1" style="display: none;"></div>
      </div>

      <button type="submit" class="btn btn-primary-modern w-100 justify-content-center py-3 mt-3">
        Create Account
      </button>
    </form>

    <div class="auth-footer">
      Already have an account? <a href="/login">Sign in</a>
    </div>
  </div>
</div>

<script src="/js/signUp-validation.js"></script>
<script src="/js/password-toggle.js"></script>