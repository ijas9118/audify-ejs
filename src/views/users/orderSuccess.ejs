<div class="checkout-container">
  <div class="container">
    <div class="success-container">
      
      <!-- Celebration Icon -->
      <div class="success-icon-wrap">
        <div class="success-icon-circle">
          <i class="fas fa-check"></i>
        </div>
        <div class="confetti" id="confetti"></div>
      </div>

      <h1 class="fw-bold mb-2">Order Confirmed!</h1>
      <p class="text-secondary mb-4">
        Thank you for your purchase. Your order <span class="fw-bold text-dark">#<%= order.orderId || order._id %></span> is being processed.
      </p>

      <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mb-5">
        <a href="/shop" class="btn btn-primary-modern justify-content-center py-2 px-4 rounded-pill">
          Continue Shopping
        </a>
        <a href="/account/order-history" class="btn btn-secondary-modern justify-content-center py-2 px-4 rounded-pill">
          Track Your Order
        </a>
      </div>

      <!-- Order Recap -->
      <div class="recap-card">
        <h5 class="fw-bold mb-4">Order Summary</h5>
        
        <div class="info-item">
          <span class="info-label text-truncate me-3">Ship to</span>
          <span class="info-value text-end"><%= order.location %>, <%= order.city %>, <%= order.zip %></span>
        </div>

        <div class="info-item">
          <span class="info-label">Payment Mode</span>
          <span class="info-value"><%= order.paymentMethod %></span>
        </div>

        <div class="info-item">
          <span class="info-label">Total Items</span>
          <span class="info-value"><%= order.orderItems.length %></span>
        </div>

        <div class="info-item mt-2 pt-3 border-top border-dark">
          <span class="fw-bold text-dark fs-5">Amount Paid</span>
          <span class="fw-bold text-dark fs-5">₹<%= order.finalTotal.toLocaleString('en-IN') %></span>
        </div>
      </div>

      <p class="mt-5 text-secondary small">
        A confirmation email has been sent to your registered email address.<br>
        Need help? <a href="#" class="text-primary text-decoration-none">Contact Support</a>
      </p>
    </div>
  </div>
</div>

<script>
  // Simple "confetti" effect logic if desired or just decorative placeholders
  document.addEventListener('DOMContentLoaded', () => {
    // You could add a real confetti library here if you wanted to be extra "premium"
    console.log('Order Success - Celebration started');
  });
</script>