<div class="account-container">
  <div class="container px-lg-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="breadcrumb-modern">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/account">My Account</a></li>
        <li class="breadcrumb-item"><a href="/account/addresses">Manage Addresses</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit Address</li>
      </ol>
    </nav>

    <div class="account-section-card col-lg-8 mx-auto">
      <div class="section-header">
        <h4 class="mb-0">Edit Address</h4>
      </div>
      
      <form action="/account/edit/<%= address._id %>" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">Address Type (e.g. Home, Work)</label>
              <input type="text" name="addressType" class="form-control" value="<%= address.addressType %>" required />
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">Custom Label (Optional)</label>
              <input type="text" name="customName" class="form-control" value="<%= address.customName %>" placeholder="e.g. My Beach House" />
            </div>
          </div>
          <div class="col-12">
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">Location / Street Address</label>
              <input type="text" name="location" class="form-control" value="<%= address.location %>" required />
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">City</label>
              <input type="text" name="city" class="form-control" value="<%= address.city %>" required />
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">State / Province</label>
              <input type="text" name="state" class="form-control" value="<%= address.state %>" required />
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">ZIP / Postal Code</label>
              <input type="text" name="zip" class="form-control" value="<%= address.zip %>" required />
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-4">
              <label class="form-label small fw-bold text-secondary">Country</label>
              <input type="text" name="country" class="form-control" value="<%= address.country %>" required />
            </div>
          </div>
        </div>

        <div class="d-flex gap-3 pt-2">
          <button type="submit" class="btn btn-primary-modern px-5 justify-content-center">
            Update Address
          </button>
          <a href="/account/addresses" class="btn btn-outline-secondary px-4 d-flex align-items-center rounded-4">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>