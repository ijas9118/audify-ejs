<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <img src="/images/svg/logo.svg" alt="Audify" class="auth-logo" />
      <h1 class="auth-title">Welcome back</h1>
      <p class="auth-subtitle">Sign in to your account to continue</p>
    </div>

    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
      <div class="alert alert-danger border-0 rounded-4 mb-4 py-2 px-3" role="alert">
        <ul class="mb-0 ps-3">
          <% errors.forEach(error => { %>
            <li class="small"><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="auth-social">
      <button type="button" class="btn-social" onclick="window.location.href='/auth/google';">
        <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" alt="Google" />
        Google
      </button>
      <button type="button" class="btn-social" id="demoLoginButton">
        <i class="fas fa-user-shield" style="color: var(--primary-color);"></i>
        Demo
      </button>
    </div>

    <div class="auth-divider">or</div>

    <form id="loginForm">
      <div class="mb-3">
        <label for="email" class="form-label ms-1">Email</label>
        <input
          type="email"
          class="form-control form-control-modern"
          id="email"
          name="email"
          placeholder="you@example.com"
          value="<%= typeof formData !== 'undefined' && formData ? (formData.user || formData.email || '') : '' %>"
        />
      </div>
      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center">
          <label for="password" class="form-label mb-0 ms-1">Password</label>
          <a href="/login/forgot-password" class="small fw-semibold" style="color: var(--primary-color); text-decoration: none;">Forgot?</a>
        </div>
        <div class="position-relative mt-1">
          <input
            type="password"
            class="form-control form-control-modern"
            id="password"
            name="password"
            placeholder="••••••••"
          />
          <button type="button" id="togglePassword" class="btn position-absolute top-50 end-0 translate-middle-y border-0 bg-transparent pe-3">
            <i class="far fa-eye text-muted" id="eyeIcon"></i>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn-primary-modern w-100 justify-content-center py-3 mt-3">
        Sign In
      </button>
    </form>

    <div class="auth-footer">
      Don't have an account? <a href="/signup">Create one</a>
    </div>
  </div>
</div>

<script src="/js/login-validation.js"></script>
<script src="/js/password-toggle.js"></script>
<script src="/js/demo-login.js"></script>