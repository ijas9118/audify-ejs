<div class="container my-5 col-md-10 col-sm-12" style="min-height: 50vh">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
      <li class="breadcrumb-item active" aria-current="page">Wishlist</li>
    </ol>
  </nav>

  <div class="container my-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h1 class="mb-0">Your Wishlist</h1>
      <% if (wishlist.length > 0) { %>
        <button
          id="move-all-to-cart-btn"
          class="btn btn-dark"
          onclick="moveAllToCart()"
        >
          <i class="fa-solid fa-cart-plus me-1"></i> Move All to Cart
        </button>
      <% } %>
    </div>

    <% if (wishlist.length > 0) { %>
      <% wishlist.forEach(product => { %>
        <div
          class="wishlist-item row align-items-center justify-content-center mb-3 py-3 border-bottom"
          id="wishlist-item-<%= product._id %>"
        >
          <div class="col-md-2 text-center">
            <img
              src="<%= product.image %>"
              class="img-fluid"
              alt="<%= product.name %>"
              style="max-height: 100px; object-fit: contain;"
            />
          </div>

          <div class="col-md-6">
            <h5 class="mb-1"><%= product.name %></h5>
            <% if (product.discountedPrice < product.price) { %>
              <p class="mb-0">
                <span class="fw-bold text-success">₹<%= product.discountedPrice.toFixed(2) %></span>
                <s class="text-muted ms-2 small">₹<%= product.price.toFixed(2) %></s>
              </p>
            <% } else { %>
              <p class="mb-0"><strong>₹<%= product.price.toFixed(2) %></strong></p>
            <% } %>
            <% if (product.isOutOfStock) { %>
              <span class="badge bg-danger mt-1">Out of Stock</span>
            <% } %>
          </div>

          <div class="col-md-4 text-end d-flex gap-2 justify-content-end">
            <% if (!product.isOutOfStock) { %>
              <button
                onclick="addToCartFromWishlist('<%= product._id %>')"
                class="btn btn-dark btn-sm"
              >
                <i class="fa-solid fa-cart-plus me-1"></i>Add to Cart
              </button>
            <% } %>
            <button
              onclick="removeProduct('<%= product._id %>')"
              class="btn btn-outline-danger btn-sm"
            >
              <i class="fa-solid fa-trash me-1"></i>Remove
            </button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="alert alert-info text-center" role="alert">
        <i class="fa-solid fa-heart me-2"></i>Your wishlist is empty.
        <a href="/shop" class="alert-link ms-1">Browse the shop</a> to add items!
      </div>
    <% } %>
  </div>
</div>

<script src="/js/wishlist.js"></script>
