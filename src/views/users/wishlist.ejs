<div class="shopping-container">
  <div class="container px-lg-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="breadcrumb-modern">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
        <li class="breadcrumb-item active" aria-current="page">Wishlist</li>
      </ol>
    </nav>

    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 mb-4 mb-lg-5">
      <h1 class="shopping-title mb-0">Your Wishlist</h1>
      <% if (wishlist.length > 0) { %>
        <button
          id="move-all-to-cart-btn"
          class="btn btn-primary-modern w-100 w-sm-auto justify-content-center"
          onclick="moveAllToCart()"
        >
          <i class="fa-solid fa-cart-plus me-2"></i> Move All to Cart
        </button>
      <% } %>
    </div>

    <% if (wishlist.length > 0) { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% wishlist.forEach(product => { %>
          <div class="col" id="wishlist-item-<%= product._id %>">
            <div class="product-card h-100 <%= product.isOutOfStock ? 'is-out-of-stock' : '' %>">
              <a href="/shop/product/<%= product._id %>" class="text-decoration-none">
                <div class="product-img-wrap">
                  <% if (product.discountedPrice < product.price) { %>
                    <span class="product-badge">
                      -<%= Math.round(((product.price - product.discountedPrice) / product.price) * 100) %>%
                    </span>
                  <% } %>
                  <img src="<%= product.image %>" alt="<%= product.name %>" />
                </div>
              </a>
              <div class="product-info">
                <div class="product-name">
                  <a href="/shop/product/<%= product._id %>"><%= product.name %></a>
                </div>
                <div class="d-flex align-items-baseline">
                  <% if (product.discountedPrice < product.price) { %>
                    <span class="product-price">₹<%= product.discountedPrice.toFixed(2) %></span>
                    <span class="product-price-original">₹<%= product.price.toFixed(2) %></span>
                  <% } else { %>
                    <span class="product-price">₹<%= product.price.toFixed(2) %></span>
                  <% } %>
                </div>
                <div class="mt-auto pt-2">
                  <% if (product.isOutOfStock) { %>
                    <span class="product-stock out-of-stock">Out of Stock</span>
                  <% } else { %>
                    <span class="product-stock in-stock">In Stock</span>
                  <% } %>
                </div>
              </div>
              <div class="product-actions">
                <% if (!product.isOutOfStock) { %>
                  <button
                    class="btn-add-cart"
                    onclick="addToCartFromWishlist('<%= product._id %>')"
                  >
                    <i class="fas fa-shopping-bag"></i> Add to Cart
                  </button>
                <% } %>
                <button
                  class="btn-wishlist border-danger text-danger"
                  style="background: #FFF5F5;"
                  onclick="removeProduct('<%= product._id %>')"
                  title="Remove from wishlist"
                >
                  <i class="fas fa-trash-alt"></i>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">
          <i class="fa-solid fa-heart"></i>
        </div>
        <h3 class="fw-bold">Your wishlist is empty</h3>
        <p class="text-secondary mb-4">Looks like you haven't added anything to your wishlist yet.</p>
        <a href="/shop" class="btn btn-primary-modern px-5 justify-content-center">Explore Products</a>
      </div>
    <% } %>
  </div>
</div>

<script src="/js/wishlist.js"></script>
