<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-title">Forgot Password?</div>
      <p class="auth-subtitle">No worries, we'll send you instructions to reset your password via email.</p>
    </div>

    <form id="forgotPasswordForm" action="/forgot-password" method="POST">
      <div class="mb-4">
        <label for="email" class="form-label">Email Address</label>
        <div class="position-relative">
          <input 
            type="email" 
            class="form-control form-control-modern" 
            id="email" 
            name="email" 
            required 
            placeholder="e.g. alex@example.com"
          >
        </div>
        <div class="form-text mt-2 small opacity-75 text-center">We'll use this to find your account.</div>
      </div>

      <button type="submit" class="btn btn-primary btn-primary-modern w-100 mb-3">
        Send Reset Link
      </button>
    </form>

    <div class="auth-footer">
      <p>Remembered your password? <a href="/login">Log in</a></p>
    </div>
  </div>
</div>
