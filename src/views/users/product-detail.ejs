<div class="product-detail-layout">
  <div class="container px-lg-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="breadcrumb-modern">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
      </ol>
    </nav>

    <div class="row g-5">
      <!-- Left: Image Gallery -->
      <div class="col-lg-7">
        <div class="product-gallery">
          <div class="gallery-thumbs">
            <!-- Main Image Thumbnail -->
            <div class="thumb-item active" onclick="updateMainImage('<%= product.images.main %>', this)">
              <img src="<%= product.images.main %>" alt="Main" />
            </div>
            <!-- Supporting Images -->
            <% if (product.images.supports && product.images.supports.length > 0) { %>
              <% product.images.supports.forEach((img, index) => { %>
                <div class="thumb-item" onclick="updateMainImage('<%= img %>', this)">
                  <img src="<%= img %>" alt="View <%= index + 1 %>" />
                </div>
              <% }); %>
            <% } %>
          </div>

          <div class="gallery-main" id="imageZoomWrapper">
            <img id="mainImage" src="<%= product.images.main %>" alt="<%= product.name %>" />
            <div class="zoom-hint">
              <i class="fas fa-search-plus me-1"></i> Hover to zoom
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Product Info -->
      <div class="col-lg-5">
        <div class="detail-info">
          <!-- Category Label? Could add if available -->
          
          <h1 class="detail-name"><%= product.name %></h1>

          <div class="detail-price-row">
            <% if (product.discountedPrice < product.price) { %>
              <span class="detail-price">₹<%= product.discountedPrice.toFixed(2) %></span>
              <span class="detail-price-original">₹<%= product.price.toFixed(2) %></span>
            <% } else { %>
              <span class="detail-price">₹<%= product.price.toFixed(2) %></span>
            <% } %>
          </div>

          <div class="detail-desc">
            <%= product.description %>
          </div>

          <!-- Stock Status -->
          <% if (product.isOutOfStock) { %>
            <div class="stock-status out-of-stock">
              <i class="fas fa-times-circle"></i> Out of Stock
            </div>
          <% } else { %>
            <div class="stock-status in-stock">
              <i class="fas fa-check-circle"></i> In Stock (<%= product.stock %> available)
            </div>
          <% } %>

          <!-- Features / Brief list -->
          <ul class="list-unstyled mb-4">
            <li class="mb-2 small text-secondary"><i class="fas fa-shield-alt me-2 text-primary"></i> 1 Year Brand Warranty</li>
            <li class="mb-2 small text-secondary"><i class="fas fa-truck me-2 text-primary"></i> Free Express Delivery</li>
            <li class="mb-2 small text-secondary"><i class="fas fa-undo me-2 text-primary"></i> 7 Days Replacement Policy</li>
          </ul>

          <!-- Actions -->
          <div class="detail-actions">
            <button
              class="btn btn-primary-modern btn-detail-add-cart justify-content-center <%= product.isOutOfStock ? 'disabled' : '' %>"
              onclick="addToCart('<%= product._id %>')"
            >
              <i class="fas fa-shopping-bag me-2"></i> Add to Cart
            </button>
            <button
              class="btn-detail-wishlist"
              onclick="addToWishList('<%= product._id %>')"
              title="Add to wishlist"
            >
              <i class="far fa-heart"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Related Products Section -->
  <div class="container px-lg-5 mt-5 pt-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h2 class="h4 fw-bold mb-0">Related Products</h2>
      <a href="/shop" class="text-primary text-decoration-none fw-semibold small">View All <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
    
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
      <% relatedProducts.forEach(product => { %>
      <div class="col">
        <div class="product-card h-100">
          <a href="/shop/product/<%= product._id %>" class="text-decoration-none">
            <div class="product-img-wrap">
              <% if (product.discountedPrice < product.price) { %>
                <span class="product-badge">
                  -<%= Math.round(((product.price - product.discountedPrice) / product.price) * 100) %>%
                </span>
              <% } %>
              <img src="<%= product.images.main %>" alt="<%= product.name %>" />
            </div>
          </a>
          <div class="product-info">
            <div class="product-name">
              <a href="/shop/product/<%= product._id %>"><%= product.name %></a>
            </div>
            <div class="d-flex align-items-baseline">
              <% if (product.discountedPrice < product.price) { %>
                <span class="product-price">₹<%= product.discountedPrice.toFixed(2) %></span>
                <span class="product-price-original">₹<%= product.price.toFixed(2) %></span>
              <% } else { %>
                <span class="product-price">₹<%= product.price.toFixed(2) %></span>
              <% } %>
            </div>
          </div>
          <div class="product-actions">
            <button class="btn-add-cart" onclick="addToCart('<%= product._id %>')">
              <i class="fas fa-shopping-bag"></i> Add to Cart
            </button>
            <button class="btn-wishlist" onclick="addToWishList('<%= product._id %>')">
              <i class="far fa-heart"></i>
            </button>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</div>

<script>
  function updateMainImage(src, thumbEl) {
    document.getElementById('mainImage').src = src;
    // Update active thumb
    document.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('active'));
    thumbEl.classList.add('active');
  }

  // Modern Zoom Effect
  const wrapper = document.getElementById('imageZoomWrapper');
  const img = document.getElementById('mainImage');

  wrapper.addEventListener('mousemove', (e) => {
    const { left, top, width, height } = wrapper.getBoundingClientRect();
    const x = ((e.pageX - left - window.scrollX) / width) * 100;
    const y = ((e.pageY - top - window.scrollY) / height) * 100;
    img.style.transformOrigin = `${x}% ${y}%`;
    img.style.transform = 'scale(2)';
  });

  wrapper.addEventListener('mouseleave', () => {
    img.style.transform = 'scale(1)';
    img.style.transformOrigin = 'center center';
  });
</script>

<script src="/js/cart.js"></script>
<script src="/js/wishlist.js"></script>