<div
  class="container my-5 col-md-10 col-sm-12"
  style="min-height: 50vh"
>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/account">My Account</a></li>
      <li class="breadcrumb-item active" aria-current="page">
        Order History
      </li>
    </ol>
  </nav>
  <h2 class="mb-4">Order History</h2>

  <% if (orders.length === 0) { %>
    <div class="alert alert-info text-center" role="alert">No orders found.</div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">Order #</th>
            <th scope="col">Order date</th>
            <th scope="col">Status</th>
            <th scope="col">Total</th>
            <th scope="col">Items</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach((order) => { %>
            <%
              // Prefer human-readable orderId; fall back to MongoDB _id for legacy orders
              const displayId = order.orderId || order._id;
              const statusBadgeClass = order.status === 'Delivered'
                ? 'order-status-pill is-delivered'
                : order.status === 'Cancelled'
                  ? 'order-status-pill is-cancelled'
                  : order.status === 'Shipped'
                    ? 'order-status-pill is-shipped'
                    : order.status === 'Processed'
                      ? 'order-status-pill is-processed'
                      : 'order-status-pill is-pending';
            %>
            <tr onclick="window.location.href='/account/order-history/<%= displayId %>'" style="cursor: pointer;">
              <td class="align-middle"><%= displayId %></td>
              <td class="align-middle"><%= new Date(order.createdAt).toLocaleDateString() %></td>
              <td class="align-middle">
                <span class="<%= statusBadgeClass %>">
                  <%= order.status %>
                </span>
                <% if (order.cancellationRequested && order.status !== 'Cancelled') { %>
                  <span class="order-status-pill order-status-pill-requested ms-1" title="Cancellation request pending admin review">
                    <i class="fa-solid fa-clock"></i> Cancel Requested
                  </span>
                <% } %>
              </td>
              <td class="align-middle">₹<%= order.finalTotal %></td>
              <td class="align-middle">
                <div class="d-flex align-items-center">
                  <% order.orderItems.slice(0, 3).forEach(item => { %>
                    <img src="<%= item.product.images.main %>" class="img-fluid me-2" style="width: 50px; height: 50px; object-fit: cover;" alt="<%= item.product.name %>">
                  <% }); %>
                  <% if (order.orderItems.length > 3) { %>
                    <span>+<%= order.orderItems.length - 3 %></span>
                  <% } %>
                </div>
              </td>
              <td class="align-middle">
                <a href="/account/order-history/<%= displayId %>" class="btn btn-outline-primary btn-sm">View Details</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
