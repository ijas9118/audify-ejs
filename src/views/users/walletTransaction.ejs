<div class="account-container">
  <div class="container px-lg-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="breadcrumb-modern">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/account">My Account</a></li>
        <li class="breadcrumb-item active" aria-current="page">Wallet History</li>
      </ol>
    </nav>

    <div class="section-header mb-4">
      <h1 class="shopping-title mb-0">Wallet History</h1>
    </div>

    <!-- Modern Balance Card -->
    <div class="wallet-card-modern mb-5">
      <div class="wallet-label">Current Balance</div>
      <div class="wallet-amount">₹<%= user.walletBalance.toFixed(2) %></div>
      <div class="d-flex align-items-center small opacity-75">
        <i class="fas fa-shield-check me-2"></i> Verified Balance
      </div>
    </div>

    <!-- Transactions List -->
    <div class="account-section-card">
      <div class="section-header border-bottom pb-3 mb-0">
        <h4 class="mb-0">Recent Transactions</h4>
      </div>

      <div class="transaction-list">
        <% if (user.walletTransactions && user.walletTransactions.length > 0) { %>
          <% user.walletTransactions.slice().reverse().forEach((transaction) => { %>
            <div class="account-menu-item py-3">
              <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                  <div class="transaction-icon m-0 <%= transaction.transactionType === 'Credit' ? 'is-credit' : 'is-debit' %>">
                    <i class="fas fa-<%= transaction.transactionType === 'Credit' ? 'arrow-down' : 'arrow-up' %>"></i>
                  </div>
                  <div>
                    <h6 class="mb-1 fw-bold text-dark"><%= transaction.description || (transaction.transactionType === 'Credit' ? 'Refund / Add Money' : 'Purchase') %></h6>
                    <p class="text-secondary small mb-0"><%= new Date(transaction.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></p>
                  </div>
                </div>
                <div class="text-end">
                  <div class="fw-bold <%= transaction.transactionType === 'Credit' ? 'text-success' : 'text-dark' %>">
                    <%= transaction.transactionType === 'Credit' ? '+' : '-' %> ₹<%= transaction.amount.toFixed(2) %>
                  </div>
                  <div class="small text-secondary"><%= transaction.transactionType %></div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state py-5">
            <div class="empty-state-icon">
              <i class="fas fa-history"></i>
            </div>
            <h5 class="fw-bold">No transactions yet</h5>
            <p class="text-secondary">Your wallet history will appear here.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>