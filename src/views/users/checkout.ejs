<div class="checkout-container">
  <div class="container px-lg-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="breadcrumb-modern">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
        <li class="breadcrumb-item"><a href="/shop/cart">Cart</a></li>
        <li class="breadcrumb-item active" aria-current="page">Checkout</li>
      </ol>
    </nav>

    <div class="section-header mb-4">
      <h1 class="checkout-title mb-0">Complete Your Order</h1>
    </div>

    <div class="row g-4">
      <!-- Main Checkout Content -->
      <div class="col-lg-8">
        
        <!-- Cart Items Review -->
        <div class="checkout-section mb-5">
          <h5 class="fw-bold mb-3">1. Review Items</h5>
          <div class="checkout-items">
            <% cart.items.forEach(item => { %>
            <div class="checkout-item-card">
              <div class="checkout-item-img">
                <img src="<%= item.image %>" alt="<%= item.name %>" />
              </div>
              <div class="checkout-item-info">
                <h6 class="mb-1"><%= item.name %></h6>
                <div class="checkout-item-price">
                  ₹<%= item.price.toLocaleString('en-IN') %> x <%= item.quantity %>
                </div>
              </div>
              <div class="text-end">
                <div class="fw-bold text-dark">₹<%= item.subtotal.toLocaleString('en-IN') %></div>
              </div>
            </div>
            <% }); %>
          </div>
        </div>

        <!-- Address Selection -->
        <div class="checkout-section mb-5">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">2. Shipping Address</h5>
          </div>

          <div class="address-grid">
            <!-- Saved Addresses -->
            <% addresses.forEach(address => { %>
            <div 
              class="address-card-modern <%= address.isDefault ? 'is-default' : '' %>" 
              data-id="<%= address._id %>"
            >
              <div>
                <div class="address-badge">
                  <i class="fas fa-<%= address.addressType === 'home' ? 'home' : (address.addressType === 'work' ? 'briefcase' : 'map-marker-alt') %> me-1"></i>
                  <%= address.customName || address.addressType %>
                </div>
                
                <div class="address-details">
                  <div class="fw-bold mb-1 text-dark"><%= address.name || 'User' %></div>
                  <div class="text-secondary small">
                    <%= address.location %>
                  </div>
                  <div class="text-secondary small">
                    <%= address.city %>, <%= address.state %> <%= address.zip %>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>

            <!-- Add New Address Button -->
            <div class="add-address-card-modern" data-bs-toggle="modal" data-bs-target="#addAddressModal">
              <div class="add-icon">
                <i class="fas fa-plus-circle"></i>
              </div>
              <h6 class="fw-bold mb-0">Add New Address</h6>
            </div>
          </div>
        </div>

        <!-- Hidden form for shipping details -->
        <form id="checkoutForm" data-total-price="<%= cart.finalTotal%>">
          <input type="hidden" name="selectedAddressId" id="selectedAddressId" />
          
          <!-- Shipping Form (Populated when address selected) -->
          <div class="checkout-section d-none" id="shippingDetailsSection">
            <h5 class="fw-bold mb-4">Confirm Shipping Details</h5>
            <div class="card-modern p-4">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label small fw-bold">Receiver Name</label>
                  <input type="text" class="form-control form-control-modern" id="name" name="name" required />
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold">Mobile Number</label>
                  <input type="text" class="form-control form-control-modern" id="mobile" name="mobile" required />
                </div>
                <div class="col-md-6">
                  <label class="form-label small fw-bold">Alternate Mobile</label>
                  <input type="text" class="form-control form-control-modern" id="alternateMobile" name="alternateMobile" />
                </div>
                <div class="col-12">
                  <label class="form-label small fw-bold">Full Address / Location</label>
                  <textarea class="form-control form-control-modern" id="location" name="location" rows="2" required></textarea>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-bold">City</label>
                  <input type="text" class="form-control form-control-modern" id="city" name="city" required />
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-bold">State</label>
                  <input type="text" class="form-control form-control-modern" id="state" name="state" required />
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-bold">ZIP Code</label>
                  <input type="text" class="form-control form-control-modern" id="zip" name="zip" required />
                </div>
                <div class="col-12">
                  <label class="form-label small fw-bold">Landmark (Optional)</label>
                  <input type="text" class="form-control form-control-modern" id="landmark" name="landmark" />
                </div>
              </div>
            </div>
          </div>

          <!-- Checkout Button for desktop (Mobile will have its own) -->
          <div class="mt-4 d-none d-lg-block">
            <button id="placeOrder" class="btn btn-primary-modern btn-lg w-100 justify-content-center py-3" type="submit">
              Proceed to Payment
            </button>
          </div>
        </form>
      </div>

      <!-- Order Summary Column -->
      <div class="col-lg-4">
        <div class="order-summary-card">
          <h4 class="summary-title">Order Summary</h4>
          
          <!-- Coupon Section -->
          <div class="mb-4" id="couponSection">
            <label class="form-label small fw-bold text-secondary mb-2">Have a coupon?</label>
            <div class="<%= cart.appliedCoupon ? 'd-none' : '' %> coupon-input-group" id="applyCouponDiv">
              <input
                type="text"
                class="form-control coupon-input"
                id="couponCode"
                placeholder="PROMO20"
                data-cartId="<%= cart.id %>"
              />
              <button class="btn btn-primary-modern btn-apply-coupon" type="button" id="applyCouponBtn">Apply</button>
            </div>

            <!-- Applied Coupon Section -->
            <div class="<%= cart.appliedCoupon ? '' : 'd-none' %>" id="appliedCouponDiv">
              <div class="alert alert-primary d-flex justify-content-between align-items-center mb-0 p-2 px-3 border-0 rounded-3">
                <span id="appliedCouponCode" class="small fw-bold">
                  <i class="fas fa-tag me-1"></i> <strong><%= cart.appliedCoupon %></strong>
                </span>
                <button class="btn btn-link text-danger p-0 text-decoration-none small" id="removeCouponBtn">
                  <i class="fas fa-times"></i>
                </button>
              </div>
            </div>
          </div>

          <div class="summary-details">
            <div class="summary-row">
              <span>Subtotal</span>
              <span>₹<%= cart.items.reduce((acc, item) => acc + item.subtotal, 0).toLocaleString('en-IN') %></span>
            </div>
            
            <% if (cart.savings > 0) { %>
            <div class="summary-row">
              <span>Savings</span>
              <span class="savings-text">- ₹<%= cart.savings.toLocaleString('en-IN') %></span>
            </div>
            <% } %>

            <div class="summary-row">
              <span>Shipping</span>
              <span><%= cart.shippingCharge > 0 ? '₹' + cart.shippingCharge.toLocaleString('en-IN') : 'FREE' %></span>
            </div>

            <div class="summary-row total">
              <span>Grand Total</span>
              <span id="grandTotal">₹<%= cart.finalTotal.toLocaleString('en-IN') %></span>
            </div>
          </div>

          <div class="mt-4 d-lg-none">
            <button id="placeOrderMobile" class="btn btn-primary-modern btn-lg w-100 justify-content-center py-3" onclick="document.getElementById('checkoutForm').requestSubmit()">
              Proceed to Payment
            </button>
          </div>
          
          <div class="text-center mt-3 text-secondary x-small">
            <i class="fas fa-shield-alt me-1"></i> Secure Checkout Guaranteed
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal for Adding New Address -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-0 pb-0">
        <h5 class="fw-bold">Add New Address</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <form action="/account/addresses" method="POST" id="addressForm">
          <input type="hidden" name="redirectTo" value="/checkout" />
          <div class="mb-3">
            <label class="form-label small fw-bold text-secondary">Receiver Full Name</label>
            <input type="text" class="form-control" name="name" placeholder="John Doe" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-secondary">Address Line</label>
            <input type="text" class="form-control" name="location" placeholder="e.g. 123 Street Name, Apartment" required />
          </div>
          
          <div class="row g-3 mb-3">
            <div class="col-6">
              <label class="form-label small fw-bold text-secondary">City</label>
              <input type="text" class="form-control" name="city" required />
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold text-secondary">State</label>
              <input type="text" class="form-control" name="state" required />
            </div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-6">
              <label class="form-label small fw-bold text-secondary">ZIP Code</label>
              <input type="text" class="form-control" name="zip" required />
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold text-secondary">Country</label>
              <input type="text" class="form-control" name="country" value="India" required />
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold text-secondary mb-2 d-block">Address Type</label>
            <div class="d-flex gap-3">
              <div class="form-check custom-option">
                <input class="form-check-input" type="radio" name="addressType" id="typeHome" value="home" checked />
                <label class="form-check-label" for="typeHome">Home</label>
              </div>
              <div class="form-check custom-option">
                <input class="form-check-input" type="radio" name="addressType" id="typeWork" value="work" />
                <label class="form-check-label" for="typeWork">Work</label>
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-primary-modern w-100 justify-content-center py-2" id="saveAddressBtn">
            Save Address
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/checkout.js"></script>
<script src="/js/addNewAddress.js"></script>
