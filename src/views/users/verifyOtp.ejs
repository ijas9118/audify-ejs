<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <a href="/">
        <img src="/images/svg/logo.svg" alt="Audify" class="auth-logo" />
      </a>
      <h1 class="auth-title">Verify Your Email</h1>
      <p class="auth-subtitle">We've sent a 6-digit code to your email.</p>
    </div>

    <form action="/verify-otp" method="POST">
      <div class="otp-input-wrapper">
        <label for="otp" class="form-label d-block text-center mb-3">Verification Code</label>
        <input
          type="text"
          class="form-control-modern otp-input w-100"
          id="otp"
          name="otp"
          placeholder="000000"
          maxlength="6"
          pattern="\d{6}"
          required
          autofocus
        />
        <% if (error) { %>
        <div class="alert alert-danger mt-3 py-2 small border-0 text-center">
          <i class="fas fa-exclamation-circle me-1"></i> <%= error %>
        </div>
        <% } %>
      </div>

      <button type="submit" class="btn btn-primary-modern w-100 justify-content-center">
        Verify Account
      </button>

      <!-- Message for OTP Resend -->
      <div class="resend-timer" id="otp-message">
        <span id="resend-msg">
          Didn't get an OTP? Wait <span id="countdown">15</span>s
        </span>
      </div>

      <!-- Resend OTP Button -->
      <div class="text-center mt-2">
        <button
          type="button"
          id="resend-btn"
          class="btn-resend-link"
          onclick="resendOtp()"
          style="display: none"
        >
          <i class="fas fa-redo-alt me-1 x-small"></i> Resend Verification Code
        </button>
      </div>
    </form>

    <div class="auth-footer mt-5 pt-4 border-top">
      <p class="mb-0 small">
        Entered the wrong email? <a href="/signup">Change Email</a>
      </p>
    </div>
  </div>
</div>

<script src="/js/otp-resend.js"></script>
