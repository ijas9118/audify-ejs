<div class="account-container">
  <div class="container px-lg-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="breadcrumb-modern">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">My Account</li>
      </ol>
    </nav>

    <div class="account-grid">
      <!-- Left: Sidebar (Desktop only for now, can be mobile bottom nav later) -->
      <aside class="account-sidebar d-none d-lg-block">
        <div class="user-profile-brief">
          <div class="avatar-initial">
            <%= (user.firstName && user.firstName[0]) ? user.firstName[0].toUpperCase() : 'U' %>
          </div>
          <h5><%= user.firstName %> <%= user.lastName %></h5>
          <p><%= user.email %></p>
        </div>
        
        <ul class="account-nav-list">
          <li class="account-nav-item active">
            <a href="/account"><i class="fas fa-user-circle"></i> Profile Overview</a>
          </li>
          <li class="account-nav-item">
            <a href="/account/order-history"><i class="fas fa-shopping-bag"></i> My Orders</a>
          </li>
          <li class="account-nav-item">
            <a href="/account/addresses"><i class="fas fa-map-marker-alt"></i> Saved Addresses</a>
          </li>
          <li class="account-nav-item">
            <a href="/shop/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
          </li>
          <li class="account-nav-item">
            <a href="/account/wallet/transactions"><i class="fas fa-wallet"></i> Wallet History</a>
          </li>
        </ul>

        <div class="mt-4 pt-4 border-top">
          <form action="/logout" method="POST">
            <button type="submit" class="btn btn-logout-modern w-100 py-2">
              <i class="fas fa-sign-out-alt me-2"></i> Logout
            </button>
          </form>
        </div>
      </aside>

      <!-- Right: Main Content -->
      <div class="account-main-content">
        
        <!-- Welcome Header (Mobile only) -->
        <div class="d-lg-none mb-4">
          <h1 class="h3 fw-bold mb-1">Hello, <%= user.firstName %>!</h1>
          <p class="text-secondary small">Welcome back to your dashboard.</p>
        </div>

        <!-- 1. Wallet Card -->
        <div class="wallet-card-modern">
          <div class="wallet-label">Wallet Balance</div>
          <div class="wallet-amount">₹<%= user.walletBalance || 0 %></div>
          <div class="wallet-actions">
            <a href="/account/wallet/transactions" class="btn-wallet-action text-decoration-none">
              <i class="fas fa-history me-1"></i> View Transactions
            </a>
          </div>
        </div>

        <!-- 2. Quick Actions Grid -->
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-6">
            <a href="/account/order-history" class="quick-link-card">
              <div class="quick-link-icon"><i class="fas fa-box"></i></div>
              <h6>My Orders</h6>
              <p>Track or view your orders</p>
            </a>
          </div>
          <div class="col-6 col-md-6">
            <a href="/account/addresses" class="quick-link-card">
              <div class="quick-link-icon"><i class="fas fa-map-marked-alt"></i></div>
              <h6>Addresses</h6>
              <p>Manage your delivery spots</p>
            </a>
          </div>
        </div>

        <!-- 3. Profile Details Form -->
        <div class="account-section-card">
          <div class="section-header">
            <h4>Profile Information</h4>
          </div>
          
          <form id="userForm" data-id="<%= user._id %>">
            <div class="row g-3">
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label class="form-label small fw-bold text-secondary">First Name</label>
                  <input type="text" class="form-control" id="firstName" name="firstName" value="<%= user.firstName %>" required />
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label class="form-label small fw-bold text-secondary">Last Name</label>
                  <input type="text" class="form-control" id="lastName" name="lastName" value="<%= user.lastName %>" required />
                </div>
              </div>
              <div class="col-md-12">
                <div class="form-group mb-3">
                  <label class="form-label small fw-bold text-secondary">Email Address</label>
                  <input type="email" class="form-control" id="email" name="email" value="<%= user.email %>" required />
                </div>
              </div>
              <div class="col-md-12">
                <div class="form-group mb-3">
                  <label class="form-label small fw-bold text-secondary">Phone Number</label>
                  <input type="tel" class="form-control" id="phone" name="mobile" value="<%= user.mobile %>" required />
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label class="form-label small fw-bold text-secondary">Gender</label>
                  <select id="gender" name="gender" class="form-select">
                    <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
                  </select>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group mb-4">
                  <label class="form-label small fw-bold text-secondary">Date of Birth</label>
                  <input type="date" class="form-control" id="dob" name="dob" value="<%= user.dob ? new Date(user.dob).toISOString().split('T')[0] : '' %>" />
                </div>
              </div>
            </div>
            
            <div class="pt-2">
              <button type="submit" class="btn btn-primary-modern px-5 justify-content-center" id="updateButton">
                Save Changes
              </button>
            </div>
          </form>
        </div>

        <!-- 4. Account Settings & More -->
        <div class="account-section-card">
          <div class="section-header">
            <h4>Account Settings</h4>
          </div>
          
          <ul class="account-menu-list">
            <li class="account-menu-item">
              <a href="#" data-bs-toggle="modal" data-bs-target="#updatePasswordModal">
                <div class="d-flex align-items-center">
                  <i class="fas fa-key account-menu-icon"></i>
                  <span>Change Password</span>
                </div>
                <i class="fas fa-chevron-right text-muted small"></i>
              </a>
            </li>
            <li class="account-menu-item">
              <a href="#">
                <div class="d-flex align-items-center">
                  <i class="fas fa-headset account-menu-icon"></i>
                  <span>Help & Support</span>
                </div>
                <i class="fas fa-chevron-right text-muted small"></i>
              </a>
            </li>
            <li class="account-menu-item">
              <a href="#">
                <div class="d-flex align-items-center">
                  <i class="fas fa-question-circle account-menu-icon"></i>
                  <span>Frequently Asked Questions</span>
                </div>
                <i class="fas fa-chevron-right text-muted small"></i>
              </a>
            </li>
             <li class="account-menu-item">
                <a href="#">
                  <div class="d-flex align-items-center">
                    <i class="fas fa-shield-alt account-menu-icon"></i>
                    <span>Terms & Conditions</span>
                  </div>
                  <i class="fas fa-chevron-right text-muted small"></i>
                </a>
              </li>
          </ul>
        </div>

        <!-- Mobile Logout -->
        <div class="d-lg-none mb-5">
           <form action="/logout" method="POST">
              <button type="submit" class="btn btn-logout-modern w-100 py-3">
                <i class="fas fa-sign-out-alt me-2"></i> Logout
              </button>
            </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Update Password Modal (Modernized) -->
<div class="modal fade" id="updatePasswordModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-0 pb-0">
        <h5 class="fw-bold">Update Password</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <form id="updatePasswordForm">
          <div class="mb-3">
            <label class="form-label small fw-bold text-secondary">Current Password</label>
            <div class="input-group">
              <input type="password" class="form-control rounded-start" id="currentPassword" name="currentPassword" required placeholder="Enter current password">
              <button class="btn btn-outline-light border-start-0 text-secondary toggle-password" type="button" data-target="#currentPassword">
                <i class="fas fa-eye"></i>
              </button>
            </div>
            <% if (user.isGoogleUser) { %>
              <div class="mt-2 p-2 bg-light rounded-3 small text-muted border">
                <i class="fas fa-info-circle me-1"></i> Google account placeholder password: <strong>123456</strong>
              </div>
            <% } %>
          </div>
          
          <div class="mb-3">
            <label class="form-label small fw-bold text-secondary">New Password</label>
            <div class="input-group">
              <input type="password" class="form-control rounded-start" id="newPassword" name="newPassword" required placeholder="Create new password">
              <button class="btn btn-outline-light border-start-0 text-secondary toggle-password" type="button" data-target="#newPassword">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>
          
          <div class="mb-4">
            <label class="form-label small fw-bold text-secondary">Confirm Password</label>
            <div class="input-group">
              <input type="password" class="form-control rounded-start" id="confirmPassword" name="confirmPassword" required placeholder="Type again to confirm">
              <button class="btn btn-outline-light border-start-0 text-secondary toggle-password" type="button" data-target="#confirmPassword">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>
          
          <button type="submit" class="btn btn-primary-modern w-100 justify-content-center py-2">
            Update Password
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/userAccount.js"></script>