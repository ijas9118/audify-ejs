<div class="shopping-container">
  <div class="container px-lg-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="breadcrumb-modern">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cart</li>
      </ol>
    </nav>

    <h1 class="shopping-title">Your Cart</h1>

    <% if (cart && cart.items.length > 0) { %>
      <div class="row g-4">
        <!-- Cart Items -->
        <div class="col-lg-8">
          <% cart.items.forEach(item => { %>
            <div class="cart-item-card" data-product-id="<%= item.productId %>">
              <div class="cart-item-img">
                <img src="<%= item.image %>" alt="<%= item.name %>" />
              </div>
              
              <div class="cart-item-info">
                <h5 class="mb-1"><a href="/shop/product/<%= item.productId %>" class="text-decoration-none text-dark"><%= item.name %></a></h5>
                <p class="cart-item-price mb-3">₹<%= item.price.toFixed(2) %></p>
                
                <div class="d-flex align-items-center justify-content-between mt-auto">
                  <div class="quantity-control">
                    <button class="qty-btn" type="button" onclick="changeQuantity('<%= item.productId %>', -1)">
                      <i class="fa-solid fa-minus"></i>
                    </button>
                    <input type="number" class="qty-input" id="quantity-<%= item.productId %>" value="<%= item.quantity %>" min="1" max="5" readonly />
                    <button class="qty-btn" type="button" onclick="changeQuantity('<%= item.productId %>', 1)">
                      <i class="fa-solid fa-plus"></i>
                    </button>
                  </div>
                  
                  <div class="text-end">
                    <span class="text-muted small d-block mb-1">Subtotal</span>
                    <span class="fw-bold fs-5">₹<span id="subtotal-<%= item.productId %>"><%= item.subtotal.toFixed(2) %></span></span>
                  </div>
                </div>
              </div>
              
              <div class="ms-lg-3">
                <button class="btn-wishlist border-0 shadow-none text-secondary" style="background: transparent;" type="button" onclick="deleteItem('<%= item.productId %>')">
                  <i class="fa-solid fa-trash-can"></i>
                </button>
              </div>
            </div>
          <% }); %>

          <div class="mt-4 p-4 rounded-4 bg-light d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3 text-center text-sm-start">
            <span class="text-secondary fw-medium">Continue browsing more products?</span>
            <a href="/shop" class="btn btn-secondary-modern justify-content-center">
              <i class="fas fa-shopping-bag me-2"></i> Back to Shop
            </a>
          </div>
        </div>

        <!-- Cart Summary Sidebar -->
        <div class="col-lg-4">
          <div class="summary-card">
            <h4 class="summary-title">Order Summary</h4>
            
            <div class="summary-row">
              <span>Subtotal</span>
              <span class="fw-bold text-dark">₹<%= cart ? cart.items.reduce((acc, item) => acc + item.subtotal, 0).toFixed(2) : '0.00' %></span>
            </div>
            
            <div class="summary-row">
              <span>Shipping Charge</span>
              <span class="text-success fw-bold"><%= cart && cart.shippingCharge === 0 ? 'FREE' : '₹' + cart.shippingCharge.toFixed(2) %></span>
            </div>
            
            <div class="summary-total">
              <span>Total</span>
              <span>₹<%= cart ? cart.total.toFixed(2) : '0.00' %></span>
            </div>
            
            <button onclick="verifyStock()" class="btn btn-primary-modern btn-checkout w-100 justify-content-center">
              Proceed to Checkout <i class="fas fa-arrow-right ms-2"></i>
            </button>
            
            <div class="mt-4 text-center">
              <p class="text-muted small mb-0"><i class="fas fa-shield-alt me-1"></i> Secure and encrypted checkout</p>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">
          <i class="fa-solid fa-cart-shopping"></i>
        </div>
        <h3 class="fw-bold">Your cart is empty</h3>
        <p class="text-secondary mb-4">Seems like you haven't added anything to your cart yet.</p>
        <a href="/shop" class="btn btn-primary-modern px-5 justify-content-center">Shop Now</a>
      </div>
    <% } %>
  </div>
</div>

<script src="/js/cart.js"></script>