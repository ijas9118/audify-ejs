<div class="shop-layout">
  <div class="container-fluid px-lg-5">
    <div class="row g-4">
      <!-- ── Filter Sidebar ── -->
      <div class="col-lg-3">
        <div class="filter-panel">
          <div class="filter-heading">
            <span>Filters</span>
            <button
              type="button"
              class="btn-reset-filter"
              id="clear-filters-btn"
              onclick="clearFilters()"
            >
              <i class="fa-solid fa-rotate-left me-1"></i>Reset
            </button>
          </div>

          <!-- Category -->
          <div class="mb-4">
            <label for="filter-category" class="form-label">Category</label>
            <select class="form-select" id="filter-category" onchange="applyFilters()">
              <option value="">All Categories</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.name %>" <%= category === cat.name ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <!-- Price Range -->
          <div class="mb-4">
            <label class="form-label">Price Range</label>
            <div id="price-slider"></div>
            <div class="d-flex justify-content-between mt-2">
              <span id="minPriceValue" class="small fw-semibold">₹<%= minPrice %></span>
              <span id="maxPriceValue" class="small fw-semibold">₹<%= maxPrice %></span>
            </div>
            <input type="hidden" id="filter-minPrice" value="<%= minPrice %>">
            <input type="hidden" id="filter-maxPrice" value="<%= maxPrice %>">
          </div>

          <div id="slider-config"
            data-min-price="<%= minPrice %>"
            data-max-price="<%= maxPrice %>">
          </div>

          <!-- Sort By -->
          <div class="mb-0">
            <label for="filter-sort" class="form-label">Sort By</label>
            <select class="form-select" id="filter-sort" onchange="applyFilters()">
              <option value="new"         <%= sortBy === 'new'         ? 'selected' : '' %>>New Arrivals</option>
              <option value="popularity"  <%= sortBy === 'popularity'  ? 'selected' : '' %>>Popularity</option>
              <option value="price-asc"   <%= sortBy === 'price-asc'   ? 'selected' : '' %>>Price: Low to High</option>
              <option value="price-desc"  <%= sortBy === 'price-desc'  ? 'selected' : '' %>>Price: High to Low</option>
              <option value="a-z"         <%= sortBy === 'a-z'         ? 'selected' : '' %>>A – Z</option>
              <option value="z-a"         <%= sortBy === 'z-a'         ? 'selected' : '' %>>Z – A</option>
            </select>
          </div>
        </div>
      </div>

      <!-- ── Products Section ── -->
      <div class="col-lg-9">

        <!-- Search bar -->
        <div class="shop-search mb-4" style="max-width: 480px;">
          <div class="input-group">
            <span class="input-group-text">
              <i class="fa-solid fa-magnifying-glass text-muted"></i>
            </span>
            <input
              type="search"
              id="search-input"
              class="form-control"
              placeholder="Search products…"
              oninput="debouncedSearch()"
              onkeydown="if(event.key==='Enter') applyFilters()"
            >
          </div>
        </div>

        <!-- Result count -->
        <div class="d-flex align-items-center gap-3 mb-4">
          <span id="result-count" class="result-count">
            <%= totalProducts > 0 ? `${totalProducts} product${totalProducts === 1 ? '' : 's'} found` : '' %>
          </span>
          <span id="search-spinner" class="spinner-border spinner-border-sm text-secondary d-none" role="status"></span>
        </div>

        <div
          id="shop-pagination-config"
          data-total-products="<%= totalProducts || 0 %>"
          data-current-page="<%= currentPage || 1 %>"
          data-page-size="<%= pageSize || 12 %>"
          data-has-more="<%= hasMore ? 'true' : 'false' %>"
        ></div>

        <!-- Product grid -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4" id="search-results">
          <% products.forEach(product => { %>
          <div class="col">
            <div class="product-card h-100 <%= product.isOutOfStock ? 'is-out-of-stock' : '' %>">
              <a href="/shop/product/<%= product._id %>" class="text-decoration-none">
                <div class="product-img-wrap">
                  <%
                    const now = new Date();
                    const isOfferValid = (o) =>
                      o && o.status === 'active' &&
                      new Date(o.validFrom) <= now &&
                      new Date(o.validUntil) >= now;

                    const pOffer = isOfferValid(product.productOfferDetails) ? product.productOfferDetails : null;
                    const cOffer = isOfferValid(product.categoryOfferDetails) ? product.categoryOfferDetails : null;

                    let badgeOffer = null;
                    if (pOffer && cOffer) {
                      const pPrice = pOffer.discountType === 'percentage'
                        ? product.price * (1 - pOffer.discountValue / 100)
                        : product.price - pOffer.discountValue;
                      const cPrice = cOffer.discountType === 'percentage'
                        ? product.price * (1 - cOffer.discountValue / 100)
                        : product.price - cOffer.discountValue;
                      badgeOffer = pPrice <= cPrice ? pOffer : cOffer;
                    } else {
                      badgeOffer = pOffer || cOffer;
                    }
                  %>
                  <% if (badgeOffer && product.discountedPrice < product.price) { %>
                    <span class="product-badge">
                      <% if (badgeOffer.discountType === 'percentage') { %>
                        -<%= badgeOffer.discountValue %>%
                      <% } else { %>
                        -₹<%= badgeOffer.discountValue.toFixed(2) %>
                      <% } %>
                    </span>
                  <% } %>
                  <img
                    src="<%= product.images.main %>"
                    alt="<%= product.name %>"
                  />
                </div>
              </a>
              <div class="product-info">
                <div class="product-name">
                  <a href="/shop/product/<%= product._id %>"><%= product.name %></a>
                </div>
                <div class="d-flex align-items-baseline">
                  <% if (product.discountedPrice && product.discountedPrice < product.price) { %>
                    <span class="product-price">₹<%= product.discountedPrice.toFixed(2) %></span>
                    <span class="product-price-original">₹<%= product.price.toFixed(2) %></span>
                  <% } else { %>
                    <span class="product-price">₹<%= product.price.toFixed(2) %></span>
                  <% } %>
                </div>
                <div class="mt-auto pt-2">
                  <span class="product-stock <%= (product.stock === 0 || product.isOutOfStock) ? 'out-of-stock' : 'in-stock' %>">
                    <%= (product.stock === 0 || product.isOutOfStock) ? 'Out of Stock' : product.stock + ' Available' %>
                  </span>
                </div>
              </div>
              <div class="product-actions">
                <button
                  class="btn-add-cart <%= product.isOutOfStock ? 'disabled' : '' %>"
                  onclick="addToCart('<%= product._id %>')"
                >
                  <i class="fas fa-shopping-bag"></i> Add to Cart
                </button>
                <button
                  class="btn-wishlist"
                  onclick="addToWishList('<%= product._id %>')"
                  title="Add to wishlist"
                >
                  <i class="far fa-heart"></i>
                </button>
              </div>
            </div>
          </div>
          <% }) %>
        </div>

        <div id="infinite-scroll-loader" class="text-center py-4 d-none">
          <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
        </div>
        <div id="infinite-scroll-sentinel" style="height: 1px;"></div>

        <!-- Empty state -->
        <div id="no-results" class="shop-empty-state d-none">
          <i class="fa-solid fa-box-open"></i>
          <p>No products match your search. Try adjusting your filters.</p>
          <button class="btn btn-secondary-modern btn-sm" onclick="clearFilters()">Clear Filters</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/cart.js"></script>
<script src="/js/wishlist.js"></script>
<script src="/js/shop.js"></script>
