          <div class="category-content">
            <h3 class="category-name">Headphones</h3>
            <span class="category-link">Shop Now <i class="fas fa-arrow-right"></i></span>
          </div>
        </a>
      </div>
      <!-- Speakers -->
      <div class="col-6 col-lg-3">
        <a href="/shop?category=speakers" class="category-card h-100">
          <div class="category-img-wrap">
            <img src="images/Home-Category-1-Party-Speaker.png" alt="Speakers" />
