<div class="hero-section">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h1 class="hero-title">
          Discover Premium <br />
          <span style="color: var(--primary-color)">Sound Experiences</span>
        </h1>
        <p class="hero-subtitle">
          Explore our extensive range of high-quality audio products, from
          cutting-edge headphones and sleek earbuds to versatile smartwatches.
        </p>
        <div class="d-flex gap-3">
          <a href="/shop" class="btn btn-primary-modern btn-lg">
            Shop Collection
            <i class="fas fa-arrow-right"></i>
          </a>
          <a href="#categories" class="btn btn-secondary-modern btn-lg">
            Browse Categories
          </a>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="position-relative">
          <img
            src="images/Home-Banner.png"
            class="img-fluid"
            alt="Hero Image"
            loading="lazy"
          />
          <!-- Decorative elements could go here -->
        </div>
      </div>
    </div>
  </div>
</div>

<div class="section-padding bg-surface" id="categories">
  <div class="container">
    <h2 class="section-title">Explore Our Categories</h2>
    <div class="row g-4">
      <!-- Earbuds -->
      <div class="col-6 col-lg-3">
        <a href="/shop?category=earbuds" class="category-card h-100">
          <div class="category-img-wrap">
            <img src="images/Home-Category-4-Smart-Watches.png" alt="Earbuds" />
          </div>
          <div class="category-content">
            <h3 class="category-name">Earbuds</h3>
            <span class="category-link">Shop Now <i class="fas fa-arrow-right"></i></span>
          </div>
        </a>
      </div>
      <!-- Headphones -->
      <div class="col-6 col-lg-3">
        <a href="/shop?category=headphones" class="category-card h-100">
          <div class="category-img-wrap">
            <img src="images/Home-Category-3-Smart-Watches.png" alt="Headphones" />
