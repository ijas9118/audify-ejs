      </div>
      <!-- Smartwatches -->
      <div class="col-6 col-lg-3">
        <a href="/shop?category=smartwatches" class="category-card h-100">
          <div class="category-img-wrap">
            <img src="images/Home-Category-2-Smart-Watches.png" alt="Smartwatches" />
          </div>
          <div class="category-content">
            <h3 class="category-name">Smartwatches</h3>
            <span class="category-link">Shop Now <i class="fas fa-arrow-right"></i></span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>
