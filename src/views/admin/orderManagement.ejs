<%
  /**
   * Status state machine (mirrors orderManagementService.VALID_TRANSITIONS).
   * Defined here so the template can compute which <option>s to render
   * without a round-trip — the server still enforces the same rules.
   */
  const STATUS_TRANSITIONS = {
    Pending:   ['Processed', 'Cancelled'],
    Processed: ['Shipped',   'Cancelled'],
    Shipped:   ['Delivered', 'Cancelled'],
    Delivered: [],   // terminal
    Cancelled: [],   // terminal
  };

  const STATUS_BADGE = {
    Pending:   'bg-warning text-dark',
    Processed: 'bg-info text-dark',
    Shipped:   'bg-primary',
    Delivered: 'admin-order-status admin-order-status-delivered',
    Cancelled: 'admin-order-status admin-order-status-cancelled',
  };
%>

<div class="container-fluid mt-3 admin-management-page">
  <div class="admin-management-header mb-3">
    <nav aria-label="breadcrumb" class="admin-breadcrumb-wrap">
      <ol class="breadcrumb admin-breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Order Management</li>
      </ol>
    </nav>
    <h3 class="admin-management-title mt-2 mb-0">Order Management</h3>
  </div>

  <%
    const orderColumns = [
      { label: '#' },
      { label: 'Order ID' },
      { label: 'User' },
      { label: 'Total Amount' },
      { label: 'Payment Method' },
      { label: 'Status' },
      { label: 'Date Ordered' },
      { label: 'Action' },
    ];

    const orderRows = orders.map((order, index) => {
      let orderUserLabel = '';
      if (order.user && order.user.firstName) {
        orderUserLabel = `${order.user.firstName} ${order.user.lastName || ''}`.trim();
      } else if (order.user && order.user.email) {
        orderUserLabel = order.user.email;
      } else {
        orderUserLabel = order.user || '';
      }

      const displayId  = order.orderId || order._id;
      const current    = order.status;
      const allowed    = STATUS_TRANSITIONS[current] ?? [];
      const isTerminal = allowed.length === 0;

      // Build the status cell: locked badge for terminals, select for active.
      let statusCell;
      if (isTerminal) {
        statusCell = `
          <span
            class="${STATUS_BADGE[current] || 'badge bg-secondary'}"
            title="This order is in a final state and cannot be changed."
          >${current}</span>
        `;
      } else {
        // Only show the current status + allowed transitions
        const options = [current, ...allowed].map(s =>
          `<option value="${s}" ${s === current ? 'selected' : ''}>${s}</option>`
        ).join('');

        statusCell = `
          <select
            class="form-select admin-status-select"
            id="orderStatus_${order._id}"
            name="status"
            onfocus="this.dataset.previousValue=this.value"
            onchange="updateOrderStatus('${order._id}', this)"
            title="Current: ${current} — select a status to advance"
          >${options}</select>
        `;
      }

      return {
        cells: [
          { tag: 'th', className: 'admin-row-index', text: pagination.skip + index + 1 },
          { className: 'admin-cell-primary', html: `
            ${displayId}
            ${order.cancellationRequested && order.status !== 'Cancelled'
              ? '<br><span class="badge bg-warning text-dark mt-1" title="User requested cancellation"><i class="fa-solid fa-triangle-exclamation"></i> Cancel Req.</span>'
              : ''
            }
          ` },
          { text: orderUserLabel },
          { text: `₹${order.finalTotal.toFixed(2)}` },
          { text: order.paymentMethod || '' },
          { html: statusCell },
          { text: new Date(order.createdAt).toLocaleDateString() },
          {
            className: 'admin-cell-actions admin-cell-actions-compact',
            html: `
              <form action="/admin/orders/${order._id}" method="GET" class="admin-action-form">
                <button
                  type="submit"
                  class="btn admin-action-btn admin-action-btn-icon admin-action-btn-secondary"
                  title="View order"
                  aria-label="View order"
                >
                  <i class="fa-solid fa-eye"></i>
                </button>
              </form>
            `,
          },
        ],
      };
    });
  %>

  <%- include('../partials/admin_table', {
    columns: orderColumns,
    rows: orderRows,
    emptyMessage: 'No orders found',
  }) %>

  <%- include('../partials/admin_pagination', {
    pagination,
    basePath: '/admin/orders',
    extraQuery: {},
  }) %>
</div>

<script src="/js/orderManagement.js"></script>
