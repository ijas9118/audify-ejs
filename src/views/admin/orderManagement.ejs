<div class="container-fluid mt-3 admin-management-page">
  <div class="admin-management-header mb-3">
    <nav aria-label="breadcrumb" class="admin-breadcrumb-wrap">
      <ol class="breadcrumb admin-breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Order Management</li>
      </ol>
    </nav>
    <h3 class="admin-management-title mt-2 mb-0">Order Management</h3>
  </div>

  <%
    const orderColumns = [
      { label: '#' },
      { label: 'Order ID' },
      { label: 'User' },
      { label: 'Total Amount' },
      { label: 'Payment Method' },
      { label: 'Status' },
      { label: 'Date Ordered' },
      { label: 'Action' },
    ];

    const orderRows = orders.map((order, index) => {
      let orderUserLabel = '';
      if (order.user && order.user.firstName) {
        orderUserLabel = `${order.user.firstName} ${order.user.lastName || ''}`.trim();
      } else if (order.user && order.user.email) {
        orderUserLabel = order.user.email;
      } else {
        orderUserLabel = order.user || '';
      }

      // Prefer human-readable orderId; fall back to MongoDB _id for legacy orders
      const displayId = order.orderId || order._id;

      return {
        cells: [
          { tag: 'th', className: 'admin-row-index', text: pagination.skip + index + 1 },
          { className: 'admin-cell-primary', text: displayId },
          { text: orderUserLabel },
          { text: `₹${order.finalTotal.toFixed(2)}` },
          { text: order.paymentMethod || '' },
          {
            html: `
              <select
                class="form-select admin-status-select"
                id="orderStatus_${order._id}"
                name="status"
                onfocus="this.dataset.previousValue=this.value"
                onchange="updateOrderStatus('${order._id}', this)"
              >
                <option value="Pending" ${order.status === 'Pending' ? 'selected' : ''}>Pending</option>
                <option value="Processed" ${order.status === 'Processed' ? 'selected' : ''}>Processed</option>
                <option value="Shipped" ${order.status === 'Shipped' ? 'selected' : ''}>Shipped</option>
                <option value="Delivered" ${order.status === 'Delivered' ? 'selected' : ''}>Delivered</option>
                <option value="Cancelled" ${order.status === 'Cancelled' ? 'selected' : ''}>Cancelled</option>
              </select>
            `,
          },
          { text: new Date(order.createdAt).toLocaleDateString() },
          {
            className: 'admin-cell-actions admin-cell-actions-compact',
            html: `
              <form action="/admin/orders/${order._id}" method="GET" class="admin-action-form">
                <button
                  type="submit"
                  class="btn admin-action-btn admin-action-btn-icon admin-action-btn-secondary"
                  title="View order"
                  aria-label="View order"
                >
                  <i class="fa-solid fa-eye"></i>
                </button>
              </form>
            `,
          },
        ],
      };
    });
  %>

  <%- include('../partials/admin_table', {
    columns: orderColumns,
    rows: orderRows,
    emptyMessage: 'No orders found',
  }) %>

  <%- include('../partials/admin_pagination', {
    pagination,
    basePath: '/admin/orders',
    extraQuery: {},
  }) %>
</div>

<script src="/js/orderManagement.js"></script>
