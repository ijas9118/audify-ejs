<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/admin.css" />
  </head>
  <body class="admin-auth-page">
    <main class="admin-auth-shell container">
      <section class="admin-auth-card">
        <div class="admin-auth-header">
          <p class="admin-auth-eyebrow mb-2">Audify Admin</p>
          <h1 class="admin-auth-title mb-2">Sign in</h1>
          <p class="admin-auth-subtitle mb-0">Secure access to dashboard controls.</p>
        </div>

        <% if (authError) { %>
        <div class="admin-auth-alert" role="alert"><%= authError %></div>
        <% } %>

        <form action="/admin/login" method="POST" class="admin-auth-form" novalidate id="adminLoginForm">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input
              type="text"
              class="form-control admin-auth-input <%= errors && errors.username ? 'is-invalid' : '' %>"
              id="username"
              name="username"
              placeholder="Enter username"
              value="<%= formData && formData.username ? formData.username : '' %>"
              autocomplete="username"
            />
            <small class="admin-field-error" id="usernameError"><%= errors && errors.username ? errors.username : '' %></small>
          </div>
          <div class="mb-1">
            <label for="password" class="form-label">Password</label>
            <input
              type="password"
              class="form-control admin-auth-input <%= errors && errors.password ? 'is-invalid' : '' %>"
              id="password"
              name="password"
              placeholder="Enter password"
              autocomplete="current-password"
            />
            <small class="admin-field-error" id="passwordError"><%= errors && errors.password ? errors.password : '' %></small>
          </div>

          <button type="submit" class="btn btn-primary admin-auth-submit mt-4">
            Log In
          </button>
        </form>
      </section>
    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script>
      (() => {
        const form = document.getElementById('adminLoginForm');
        const username = document.getElementById('username');
        const password = document.getElementById('password');
        const usernameError = document.getElementById('usernameError');
        const passwordError = document.getElementById('passwordError');

        const setError = (input, errorEl, message) => {
          errorEl.textContent = message || '';
          input.classList.toggle('is-invalid', Boolean(message));
        };

        form.addEventListener('submit', (event) => {
          let hasError = false;

          if (!username.value.trim()) {
            setError(username, usernameError, 'Username is required');
            hasError = true;
          } else {
            setError(username, usernameError, '');
          }

          if (!password.value.trim()) {
            setError(password, passwordError, 'Password is required');
            hasError = true;
          } else {
            setError(password, passwordError, '');
          }

          if (hasError) {
            event.preventDefault();
          }
        });

        username.addEventListener('input', () => {
          if (username.value.trim()) setError(username, usernameError, '');
        });
        password.addEventListener('input', () => {
          if (password.value.trim()) setError(password, passwordError, '');
        });
      })();
    </script>
  </body>
</html>
