<div class="container-fluid mt-3 admin-management-page">
  <div class="admin-management-header mb-3">
    <nav aria-label="breadcrumb" class="admin-breadcrumb-wrap">
      <ol class="breadcrumb admin-breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Product Management</li>
      </ol>
    </nav>
    <div class="admin-management-title-row mt-2">
      <h3 class="admin-management-title mb-0">Product Management</h3>
      <button
        type="button"
        class="btn btn-primary admin-create-btn"
        data-bs-toggle="modal"
        data-bs-target="#addProductModel"
      >
        Add New Product
      </button>
    </div>
  </div>

  <%- include('../partials/admin_search', {
    action: '/admin/products',
    paramName: 'search',
    value: search || '',
    placeholder: 'Search by product name',
    debounce: 400,
    extraQuery: { limit: pagination ? pagination.limit : 8 },
  }) %>

  <div class="admin-table-shell">
    <div class="table-responsive">
      <table class="table admin-management-table align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">Sl</th>
            <th scope="col">Product Name</th>
            <th scope="col">Category</th>
            <th scope="col">Price</th>
            <th scope="col">Stock</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach((product, index) => { %>
          <tr>
            <th scope="row" class="admin-row-index"><%= (pagination ? pagination.skip : 0) + index + 1 %></th>
            <td class="admin-cell-primary"><%= product.name %></td>
            <td><%= product.categoryDetails.name %></td>
            <td>₹<%= product.price.toFixed(2) %></td>
            <td>
              <span class="admin-stock-pill <%= product.isOutOfStock ? 'is-out' : 'is-in' %>">
                <% if (product.isOutOfStock) { %>
                Out of Stock
                <% } else { %>
                <%= product.stock %> in stock
                <% } %>
              </span>
            </td>
            <td class="admin-cell-actions">
              <div class="admin-action-group">
                <form
                  action="/admin/products/edit/<%= product._id %>"
                  method="GET"
                  class="w-100"
                >
                  <button type="submit" class="btn admin-action-btn admin-action-btn-secondary">
                    Edit
                  </button>
                </form>
                <form
                  action="/admin/products/toggle/<%= product._id %>"
                  method="GET"
                  class="w-100"
                  data-confirm="true"
                  data-confirm-title="<%= product.isActive ? 'Unlist Product' : 'List Product' %>"
                  data-confirm-message="<%= product.isActive ? 'This product will be hidden from the storefront.' : 'This product will be visible on the storefront.' %>"
                  data-confirm-text="<%= product.isActive ? 'Unlist' : 'List' %>"
                  data-confirm-variant="danger"
                >
                  <input type="hidden" name="page" value="<%= pagination ? pagination.currentPage : 1 %>" />
                  <input type="hidden" name="limit" value="<%= pagination ? pagination.limit : 10 %>" />
                  <input type="hidden" name="search" value="<%= search || '' %>" />
                  <button
                    type="submit"
                    class="btn admin-action-btn <%= product.isActive ? 'admin-action-btn-danger' : 'admin-action-btn-success' %>"
                  >
                    <%= product.isActive ? "Unlist" : "List" %>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }); %>
          <% if (!products.length) { %>
          <tr>
            <td colspan="6" class="text-center admin-empty-row">No products found</td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (pagination) { %>
  <%- include('../partials/admin_pagination', {
    pagination,
    basePath: '/admin/products',
    extraQuery: { search: search || '' },
  }) %>
  <% } %>
</div>

<!-- Add Product Modal -->
<div
  class="modal fade"
  id="addProductModel"
  tabindex="-1"
  aria-labelledby="addProductModelLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-xl">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header bg-dark">
        <h5 class="modal-title" id="addProductModelLabel">Add New Product</h5>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <form
        action="/admin/products/"
        method="POST"
        enctype="multipart/form-data"
      >
        <div class="modal-body">
          <div class="row">
            <div class="mb-3">
              <label for="productName" class="form-label">Product Name</label>
              <input
                type="text"
                class="form-control custom-search-input"
                id="productName"
                name="name"
                required
              />
            </div>
            <div class="mb-3">
              <label for="productDescription" class="form-label"
                >Description</label
              >
              <textarea
                class="form-control custom-search-input"
                id="productDescription"
                name="description"
              ></textarea>
            </div>
            <div class="col-md-6 mb-3">
              <label for="productPrice" class="form-label">Product Price</label>
              <input
                type="number"
                class="form-control custom-search-input"
                id="productPrice"
                name="price"
                required
              />
            </div>
            <!-- Stock Input -->
            <div class="col-md-6 mb-3">
              <label for="productStock" class="form-label">Stock</label>
              <input
                type="number"
                class="form-control custom-search-input"
                id="productStock"
                name="stock"
                min="0"
                max="100"
                required
              />
            </div>
          </div>
          <div class="mb-3">
            <label for="productCategory" class="form-label">Category</label>
            <select
              class="form-select"
              id="productCategory"
              name="categoryId"
              required
            >
              <option selected disabled value="">Choose a category</option>
              <% categories.forEach(category => { %>
              <option value="<%= category._id %>"><%= category.name %></option>
              <% }); %>
            </select>
          </div>

          <!-- Main Image Upload -->
          <div class="row">
            <div class="col-md-4 mb-3">
              <label for="mainImage" class="form-label">Main Image</label>
              <input
                type="file"
                class="form-control custom-search-input image-input"
                id="mainImageInput"
                name="mainImage"
                accept="image/*"
              />
              <img
                id="mainImagePreview"
                src=""
                alt="Main Image Preview"
                class="img-fluid mt-2 preview-img"
                style="display: none; width: 250px; height: auto"
              />
              <button class="btn btn-primary crop-button" style="display: none">
                Crop Image
              </button>
            </div>

            <!-- Support Images Upload -->
            <div class="col-md-4 mb-3">
              <label class="form-label">Support Images 1</label>
              <input
                type="file"
                class="form-control custom-search-input image-input"
                id="supportImageInput1"
                name="supportImages"
                accept="image/*"
              />
              <img
                id="supportImagePreview1"
                src=""
                alt="Support Image 1 Preview"
                class="img-fluid mt-2 preview-img"
                style="display: none; width: 250px; height: auto"
              />
              <button class="btn btn-primary crop-button" style="display: none">
                Crop Image
              </button>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Support Images 2</label>
              <input
                type="file"
                class="form-control custom-search-input image-input"
                id="supportImageInput2"
                name="supportImages"
                accept="image/*"
              />
              <img
                id="supportImagePreview2"
                src=""
                alt="Support Image 2 Preview"
                class="img-fluid mt-2 preview-img"
                style="display: none; width: 250px; height: auto"
              />
              <button class="btn btn-primary crop-button" style="display: none">
                Crop Image
              </button>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            Close
          </button>
          <button type="submit" class="btn btn-primary">Add Product</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/addProduct.js"></script>
