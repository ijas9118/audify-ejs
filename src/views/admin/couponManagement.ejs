<div class="container-fluid mt-3 admin-management-page">
  <div class="admin-management-header mb-3">
    <nav aria-label="breadcrumb" class="admin-breadcrumb-wrap">
      <ol class="breadcrumb admin-breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Coupon Management</li>
      </ol>
    </nav>
    <div class="admin-management-title-row mt-2">
      <h3 class="admin-management-title mb-0">Coupon Management</h3>
      <button
        type="button"
        class="btn btn-primary admin-create-btn"
        data-bs-toggle="modal"
        data-bs-target="#addCouponModal"
      >
        Add New Coupon
      </button>
    </div>
  </div>

  <%- include('../partials/admin_search', {
    action: '/admin/coupons',
    paramName: 'search',
    value: search || '',
    placeholder: 'Search by coupon code or discount type',
    debounce: 400,
    extraQuery: { limit: pagination.limit },
  }) %>

  <%
    const couponColumns = [
      { label: '#' },
      { label: 'Coupon Code' },
      { label: 'Discount' },
      { label: 'Max Discount' },
      { label: 'Per User Limit' },
      { label: 'Total Usage Limit' },
      { label: 'Valid From' },
      { label: 'Valid Until' },
      { label: 'Status' },
      { label: 'Actions' },
    ];

    const couponRows = coupons.map((coupon, index) => ({
      dataAttrs: { 'coupon-id': coupon._id },
      cells: [
        { tag: 'th', className: 'admin-row-index', text: pagination.skip + index + 1 },
        {
          id: `couponCodeDisplay${coupon._id}`,
          className: 'admin-cell-primary',
          text: coupon.code,
        },
        {
          id: `discountTypeDisplay${coupon._id}`,
          text:
            coupon.discountType === 'percentage'
              ? `${coupon.discountValue}%`
              : `₹${coupon.discountValue}`,
        },
        {
          id: `maxDiscountValueDisplay${coupon._id}`,
          text: coupon.maxDiscountValue ? `₹${coupon.maxDiscountValue}` : '-',
        },
        {
          id: `perUserLimitDisplay${coupon._id}`,
          text: coupon.perUserLimit ? coupon.perUserLimit : 'Unlimited',
        },
        {
          id: `totalUsageLimitDisplay${coupon._id}`,
          text: coupon.totalUsageLimit ? coupon.totalUsageLimit : 'Unlimited',
        },
        {
          id: `validFromDisplay${coupon._id}`,
          text: new Date(coupon.validFrom).toLocaleDateString(),
        },
        {
          id: `validUntilDisplay${coupon._id}`,
          text: new Date(coupon.validUntil).toLocaleDateString(),
        },
        {
          html: `
            <span
              id="isActiveDisplay${coupon._id}"
              class="admin-status-badge ${coupon.isActive ? 'is-positive' : 'is-negative'}"
              onclick="toggleCouponStatus('${coupon._id}')"
            >
              ${coupon.isActive ? 'Active' : 'Inactive'}
            </span>
          `,
        },
        {
          className: 'admin-cell-actions admin-cell-actions-compact',
          html: `
            <div class="admin-action-group">
              <a
                href="/admin/coupons/view/${coupon._id}"
                class="btn admin-action-btn admin-action-btn-icon admin-action-btn-secondary"
                title="View coupon"
                aria-label="View coupon"
              >
                <i class="fa-solid fa-eye"></i>
              </a>
              <a
                href="/admin/coupons/edit/${coupon._id}"
                class="btn admin-action-btn admin-action-btn-icon admin-action-btn-secondary"
                title="Edit coupon"
                aria-label="Edit coupon"
              >
                <i class="fa-solid fa-pen-to-square"></i>
              </a>
              <button
                class="btn admin-action-btn admin-action-btn-icon admin-action-btn-danger-alt"
                onclick="deleteCoupon('${coupon._id}')"
                title="Archive coupon"
                aria-label="Archive coupon"
              >
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          `,
        },
      ],
    }));
  %>

  <%- include('../partials/admin_table', {
    columns: couponColumns,
    rows: couponRows,
    emptyMessage: 'No coupons found',
  }) %>

  <%- include('../partials/admin_pagination', {
    pagination,
    basePath: '/admin/coupons',
    extraQuery: { search: search || '' },
  }) %>
</div>

<!-- Bootstrap Modal for Adding Coupon -->
<div
  class="modal fade admin-confirm-modal"
  id="addCouponModal"
  tabindex="-1"
  aria-labelledby="addCouponModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-xl modal-dialog-centered admin-form-modal">
    <div class="modal-content admin-form-modal-content admin-confirm-content">
      <div class="modal-header admin-form-modal-header admin-confirm-header">
        <div>
          <h5 class="modal-title admin-form-modal-title admin-confirm-title" id="addCouponModalLabel">Add New Coupon</h5>
          <p class="admin-form-modal-subtitle mb-0">Configure identity, discount rules, limits, and validity.</p>
        </div>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <form id="addCouponForm" novalidate>
        <div class="modal-body admin-form-modal-body">
          <div class="admin-coupon-form-grid">
            <section class="admin-coupon-form-section pt-0">
              <h5 class="admin-coupon-form-title">Identity</h5>
              <p class="admin-coupon-form-subtitle">Define coupon code and active status.</p>

              <div class="row g-3">
                <div class="col-md-6">
                  <label for="couponCode" class="form-label">Coupon Code</label>
                  <input
                    type="text"
                    class="form-control custom-search-input admin-coupon-input"
                    id="couponCode"
                    placeholder="Enter Coupon Code"
                    maxlength="20"
                    data-msg-required="Coupon code is required."
                    data-msg-invalid="Coupon code must be 3-20 letters or numbers."
                    required
                  />
                  <div class="invalid-feedback">Coupon code is required.</div>
                </div>
                <div class="col-md-6">
                  <label for="isActive" class="form-label">Coupon Status</label>
                  <select class="form-select admin-coupon-select" id="isActive">
                    <option value="true" selected>Active</option>
                    <option value="false">Inactive</option>
                  </select>
                </div>
              </div>
            </section>

            <section class="admin-coupon-form-section">
              <h5 class="admin-coupon-form-title">Discount Rules</h5>
              <p class="admin-coupon-form-subtitle">Set type, value, and spending threshold.</p>

              <div class="row g-3">
                <div class="col-md-6">
                  <label for="discountType" class="form-label">Discount Type</label>
                  <select
                    class="form-select admin-coupon-select"
                    id="discountType"
                    data-msg-required="Discount type is required."
                    required
                  >
                    <option value="" selected>Select Discount Type</option>
                    <option value="percentage">Percentage</option>
                    <option value="fixed">Fixed Amount</option>
                  </select>
                  <div class="invalid-feedback">Discount type is required.</div>
                </div>
                <div class="col-md-6">
                  <label for="discountValue" class="form-label">Discount Value</label>
                  <input
                    type="number"
                    class="form-control custom-search-input admin-coupon-input"
                    id="discountValue"
                    placeholder="Enter Discount Value"
                    min="0.01"
                    step="0.01"
                    data-msg-required="Discount value is required."
                    data-msg-invalid="Discount value must be greater than 0."
                    required
                  />
                  <div class="invalid-feedback">Discount value is required.</div>
                </div>
                <div class="col-md-6">
                  <label for="maxDiscountValue" class="form-label">Max Discount Value</label>
                  <input
                    type="number"
                    class="form-control custom-search-input admin-coupon-input"
                    id="maxDiscountValue"
                    placeholder="Enter Max Discount Value"
                    min="0"
                    step="0.01"
                    data-msg-invalid="Max discount must be a non-negative number."
                  />
                  <div class="invalid-feedback">Max discount must be a non-negative number.</div>
                </div>
                <div class="col-md-6">
                  <label for="minCartValue" class="form-label">Minimum Cart Subtotal</label>
                  <input
                    type="number"
                    class="form-control custom-search-input admin-coupon-input"
                    id="minCartValue"
                    placeholder="Enter Minimum Cart Value"
                    min="0"
                    step="0.01"
                    data-msg-invalid="Minimum cart subtotal must be non-negative."
                  />
                  <div class="invalid-feedback">Minimum cart subtotal must be non-negative.</div>
                </div>
              </div>
            </section>

            <section class="admin-coupon-form-section">
              <h5 class="admin-coupon-form-title">Validity & Limits</h5>
              <p class="admin-coupon-form-subtitle">Control active dates and usage caps.</p>

              <div class="row g-3">
                <div class="col-md-6">
                  <label for="validFrom" class="form-label">Valid From</label>
                  <input
                    type="date"
                    class="form-control custom-search-input admin-coupon-input"
                    id="validFrom"
                    data-msg-required="Valid from date is required."
                    required
                  />
                  <div class="invalid-feedback">Valid from date is required.</div>
                </div>
                <div class="col-md-6">
                  <label for="validUntil" class="form-label">Valid Until</label>
                  <input
                    type="date"
                    class="form-control custom-search-input admin-coupon-input"
                    id="validUntil"
                    data-msg-required="Valid until date is required."
                    required
                  />
                  <div class="invalid-feedback">Valid until date is required.</div>
                </div>
                <div class="col-md-6">
                  <label for="perUserLimit" class="form-label">Per User Limit</label>
                  <input
                    type="number"
                    class="form-control custom-search-input admin-coupon-input"
                    id="perUserLimit"
                    placeholder="Limit per user"
                    value="1"
                    min="1"
                    step="1"
                    data-msg-invalid="Per user limit must be at least 1."
                  />
                  <div class="invalid-feedback">Per user limit must be at least 1.</div>
                </div>
                <div class="col-md-6">
                  <label for="totalUsageLimit" class="form-label">Total Usage Limit</label>
                  <input
                    type="number"
                    class="form-control custom-search-input admin-coupon-input"
                    id="totalUsageLimit"
                    placeholder="Global total limit"
                    value="0"
                    min="0"
                    step="1"
                    data-msg-invalid="Total usage limit must be non-negative."
                  />
                  <div class="invalid-feedback">Total usage limit must be non-negative.</div>
                </div>
              </div>
            </section>
          </div>
        </div>

        <div class="modal-footer admin-form-modal-footer admin-confirm-footer">
          <button type="button" class="btn admin-action-btn admin-action-btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary admin-create-btn">Add Coupon</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/couponManagement.js"></script>
