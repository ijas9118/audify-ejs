<div class="container-fluid mt-3 admin-management-page admin-dashboard-page">
  <h3 class="admin-management-title my-3">Dashboard</h3>

  <section class="admin-dashboard-panel">
    <div class="admin-dashboard-panel-head">
      <h5 class="admin-dashboard-panel-title mb-0">Sales Report</h5>
      <div class="admin-dashboard-controls">
        <div class="dropdown">
          <button
            class="btn admin-dashboard-filter-btn dropdown-toggle"
            id="filterDropdown"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            Daily
          </button>
          <ul class="dropdown-menu admin-dashboard-dropdown" aria-labelledby="filterDropdown">
            <li><a class="dropdown-item" href="#" data-value="Daily">Daily</a></li>
            <li><a class="dropdown-item" href="#" data-value="Weekly">Weekly</a></li>
            <li><a class="dropdown-item" href="#" data-value="Monthly">Monthly</a></li>
            <li><a class="dropdown-item" href="#" data-value="Yearly">Yearly</a></li>
            <li><a class="dropdown-item" href="#" data-value="Custom Date Range">Custom Date Range</a></li>
          </ul>
        </div>

        <div id="customDateRange" class="d-none admin-dashboard-date-range">
          <input
            type="date"
            id="startDate"
            class="form-control admin-dashboard-date-input"
            placeholder="Start Date"
          />
          <input
            type="date"
            id="endDate"
            class="form-control admin-dashboard-date-input"
            placeholder="End Date"
          />
          <button class="btn btn-primary admin-dashboard-apply-btn">Apply</button>
        </div>
      </div>
    </div>

    <div class="admin-table-shell">
      <div class="table-responsive">
        <table class="table admin-management-table admin-dashboard-report-table align-middle mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Total Sales Revenue</th>
              <th>Discount Applied</th>
              <th>Net Sales</th>
              <th>Number of Orders</th>
              <th>Total Items Sold</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>0</td>
              <td>0</td>
              <td>0</td>
              <td>0</td>
              <td>0</td>
              <td>0</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-sm-6 col-lg-4">
        <div class="admin-kpi-card">
          <p class="admin-kpi-label mb-1">Total Sales Count</p>
          <p id="totalSalesCount" class="admin-kpi-value mb-0">0 Orders</p>
        </div>
      </div>
      <div class="col-sm-6 col-lg-4">
        <div class="admin-kpi-card">
          <p class="admin-kpi-label mb-1">Overall Order Amount</p>
          <p id="overallOrderAmount" class="admin-kpi-value mb-0">0</p>
        </div>
      </div>
      <div class="col-sm-6 col-lg-4">
        <div class="admin-kpi-card">
          <p class="admin-kpi-label mb-1">Overall Discount</p>
          <p id="overallDiscount" class="admin-kpi-value mb-0">0</p>
        </div>
      </div>
    </div>

    <div class="admin-dashboard-downloads mt-3">
      <button id="pdfDownload" class="btn admin-action-btn admin-action-btn-secondary">
        Download PDF
      </button>
      <button id="excelDownload" class="btn admin-action-btn admin-action-btn-success">
        Download Excel
      </button>
    </div>
  </section>

  <section class="admin-dashboard-panel mt-4">
    <div class="admin-dashboard-panel-head">
      <h5 class="admin-dashboard-panel-title mb-0">Sales Chart</h5>
      <div class="dropdown">
        <button
          class="btn admin-dashboard-filter-btn dropdown-toggle"
          id="chartFilterDropdown"
          type="button"
          data-bs-toggle="dropdown"
          aria-expanded="false"
        >
          Monthly
        </button>
        <ul class="dropdown-menu admin-dashboard-dropdown" aria-labelledby="chartFilterDropdown">
          <li><a class="dropdown-item" href="#" data-value="Daily">Daily</a></li>
          <li><a class="dropdown-item" href="#" data-value="Weekly">Weekly</a></li>
          <li><a class="dropdown-item" href="#" data-value="Monthly">Monthly</a></li>
          <li><a class="dropdown-item" href="#" data-value="Yearly">Yearly</a></li>
          <li><a class="dropdown-item" href="#" data-value="Custom Date Range">Custom Date Range</a></li>
        </ul>
      </div>
    </div>
    <div class="admin-dashboard-chart-wrap">
      <canvas id="salesChart"></canvas>
    </div>
  </section>

  <div class="row g-4 mt-1">
    <div class="col-lg-6">
      <section class="admin-dashboard-panel h-100">
        <div class="admin-dashboard-panel-head">
          <h5 class="admin-dashboard-panel-title mb-0">Best Selling Products (Top 10)</h5>
        </div>
        <div class="admin-table-shell">
          <div class="table-responsive">
            <table class="table admin-management-table align-middle mb-0">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Product Image</th>
                  <th>Product Name</th>
                  <th>Popularity</th>
                </tr>
              </thead>
              <tbody id="bestSellingProducts"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>

    <div class="col-lg-6">
      <section class="admin-dashboard-panel h-100">
        <div class="admin-dashboard-panel-head">
          <h5 class="admin-dashboard-panel-title mb-0">Best Selling Categories (Top 3)</h5>
        </div>
        <div class="admin-table-shell">
          <div class="table-responsive">
            <table class="table admin-management-table align-middle mb-0">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Category Name</th>
                  <th>Popularity</th>
                </tr>
              </thead>
              <tbody id="bestSellingCategories"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script src="/js/adminHome.js"></script>
  <script src="/js/salesData.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.13/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.5/xlsx.full.min.js"></script>
</div>
