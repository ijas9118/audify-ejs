<div class="container-fluid mt-3 admin-management-page">
  <div class="admin-management-header mb-3">
    <nav aria-label="breadcrumb" class="admin-breadcrumb-wrap">
      <ol class="breadcrumb admin-breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">User Management</li>
      </ol>
    </nav>
    <h3 class="admin-management-title mt-2 mb-0">User Management</h3>
  </div>

  <%- include('../partials/admin_search', {
    action: '/admin/users',
    paramName: 'search',
    value: search || '',
    placeholder: 'Search by first name, last name, or email',
    debounce: 400,
    extraQuery: { limit: pagination.limit },
  }) %>

  <%
    const attr = (value = '') =>
      String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('"', '&quot;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;');

    const userColumns = [
      { label: '#' },
      { label: 'Name' },
      { label: 'Email' },
      { label: 'Phone' },
      { label: 'Gender' },
      { label: 'Action' },
    ];

    const userRows = users.map((user, index) => {
      const toggleTitle = user.status === 'Active' ? 'Block user' : 'Unblock user';
      const toggleIcon = user.status === 'Active' ? 'fa-user-slash' : 'fa-user-check';
      const toggleClass =
        user.status === 'Active' ? 'admin-action-btn-danger' : 'admin-action-btn-success';

      return {
        cells: [
          { tag: 'th', className: 'admin-row-index', text: pagination.skip + index + 1 },
          { className: 'admin-cell-primary', text: `${user.firstName} ${user.lastName || ''}`.trim() },
          { text: user.email || '' },
          { text: user.mobile || '' },
          { text: user.gender || '' },
          {
            className: 'admin-cell-actions admin-cell-actions-compact',
            html: `
              <form
                action="/admin/users/toggle/${user._id}"
                method="GET"
                class="admin-action-form"
                data-confirm="true"
                data-confirm-title="${user.status === 'Active' ? 'Block User' : 'Unblock User'}"
                data-confirm-message="${user.status === 'Active' ? 'This user will be blocked from accessing the account.' : 'This user will regain account access.'}"
                data-confirm-text="${user.status === 'Active' ? 'Block' : 'Unblock'}"
                data-confirm-variant="danger"
              >
                <input type="hidden" name="page" value="${pagination.currentPage}" />
                <input type="hidden" name="limit" value="${pagination.limit}" />
                <input type="hidden" name="search" value="${attr(search || '')}" />
                <button
                  type="submit"
                  class="btn admin-action-btn admin-action-btn-icon ${toggleClass}"
                  title="${toggleTitle}"
                  aria-label="${toggleTitle}"
                >
                  <i class="fa-solid ${toggleIcon}"></i>
                </button>
              </form>
            `,
          },
        ],
      };
    });
  %>

  <%- include('../partials/admin_table', {
    columns: userColumns,
    rows: userRows,
    emptyMessage: 'No users found',
  }) %>

  <%- include('../partials/admin_pagination', {
    pagination,
    basePath: '/admin/users',
    extraQuery: { search: search || '' },
  }) %>
</div>
