<div class="container-fluid mt-3">
  <div class="row">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item">
          <a href="/admin" class="text-light">Admin</a>
        </li>
        <li class="breadcrumb-item active text-info" aria-current="page">
          User Management
        </li>
      </ol>
    </nav>
    <div class="container">
      <div class="row">
        <h3 class="mb-3 text-light">User Management</h3>
        <%- include('../partials/admin_search', {
          action: '/admin/users',
          paramName: 'search',
          value: search || '',
          placeholder: 'Search by first name, last name, or email',
          debounce: 400,
          extraQuery: { limit: pagination.limit },
        }) %>
        <div class="table-responsive">
          <table class="table text-light">
            <thead>
              <tr>
                <th scope="col">Sl</th>
                <th scope="col">Name</th>
                <th scope="col">Email</th>
                <th scope="col">Phone</th>
                <th scope="col">Gender</th>
                <th scope="col">Action</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach((user, index) => { %>
              <tr>
                <th scope="row"><%= pagination.skip + index + 1 %></th>
                <td><%= user.firstName %> <%= user.lastName %></td>
                <td><%= user.email %></td>
                <td><%= user.mobile %></td>
                <td><%= user.gender %></td>
                <td>
                  <form
                    action="/admin/users/toggle/<%= user._id %>"
                    method="GET"
                    class="w-100"
                  >
                    <input type="hidden" name="page" value="<%= pagination.currentPage %>" />
                    <input type="hidden" name="limit" value="<%= pagination.limit %>" />
                    <input type="hidden" name="search" value="<%= search || '' %>" />
                    <button
                      type="submit"
                      class="btn w-100 <%= user.status === 'Active' ? 'btn-outline-light' : 'btn-dark' %>"
                    >
                      <%= user.status === 'Active' ? 'Block' : 'Unblock' %>
                    </button>
                  </form>
                </td>
              </tr>
              <% }); %>
              <% if (!users.length) { %>
              <tr>
                <td colspan="6" class="text-center text-secondary">No users found</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <%- include('../partials/admin_pagination', {
          pagination,
          basePath: '/admin/users',
          extraQuery: { search: search || '' },
        }) %>
      </div>
    </div>
  </div>
</div>
