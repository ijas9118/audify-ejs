<div class="container-fluid mt-3 admin-management-page">
  <div class="admin-management-header mb-3">
    <nav aria-label="breadcrumb" class="admin-breadcrumb-wrap">
      <ol class="breadcrumb admin-breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Category Management</li>
      </ol>
    </nav>
    <div class="admin-management-title-row mt-2">
      <h3 class="admin-management-title mb-0">Category Management</h3>
      <button
        type="button"
        class="btn btn-primary admin-create-btn"
        data-bs-toggle="modal"
        data-bs-target="#addCategoryModal"
      >
        Add New Category
      </button>
    </div>
  </div>

  <%- include('../partials/admin_search', {
    action: '/admin/category',
    paramName: 'search',
    value: search || '',
    placeholder: 'Search by category name or description',
    debounce: 400,
    extraQuery: { limit: pagination.limit },
  }) %>

  <div class="admin-table-shell">
    <div class="table-responsive">
      <table class="table admin-management-table align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">Sl</th>
            <th scope="col">Category name</th>
            <th scope="col">Description</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody id="categoryList">
          <% categories.forEach((category, index) => { %>
          <tr>
            <th scope="row" class="admin-row-index"><%= pagination.skip + index + 1 %></th>
            <td class="admin-cell-primary"><%= category.name %></td>
            <td><%= category.description %></td>
            <td class="admin-cell-actions admin-cell-actions-wide">
              <div class="admin-action-group admin-action-group-3">
                <form
                  action="/admin/category/toggle/<%= category._id %>"
                  method="GET"
                  class="w-100"
                  data-confirm="true"
                  data-confirm-title="<%= category.isActive ? 'Unlist Category' : 'List Category' %>"
                  data-confirm-message="<%= category.isActive ? 'This category will be hidden from storefront navigation.' : 'This category will be available on the storefront.' %>"
                  data-confirm-text="<%= category.isActive ? 'Unlist' : 'List' %>"
                  data-confirm-variant="danger"
                >
                  <input type="hidden" name="page" value="<%= pagination.currentPage %>" />
                  <input type="hidden" name="limit" value="<%= pagination.limit %>" />
                  <input type="hidden" name="search" value="<%= search || '' %>" />
                  <button
                    type="submit"
                    class="btn admin-action-btn <%= category.isActive ? 'admin-action-btn-danger' : 'admin-action-btn-success' %>"
                  >
                    <%= category.isActive ? "Unlist" : "List" %>
                  </button>
                </form>
                <button class="btn admin-action-btn admin-action-btn-secondary" data-bs-toggle="modal" data-bs-target="#editCategoryModal<%= category._id %>">Edit</button>
                <button
                  class="btn admin-action-btn admin-action-btn-danger-alt"
                  onclick="handleCategoryDelete('<%= category._id %>')"
                >
                  Delete
                </button>
              </div>
            </td>
          </tr>
          <% }); %>
          <% if (!categories.length) { %>
          <tr>
            <td colspan="4" class="text-center admin-empty-row">No categories found</td>
          </tr>
          <% } %>
        </tbody>            
      </table>
    </div>
  </div>

  <%- include('../partials/admin_pagination', {
    pagination,
    basePath: '/admin/category',
    extraQuery: { search: search || '' },
  }) %>
</div>

<!-- Add Category Modal -->
<div
  class="modal fade"
  id="addCategoryModal"
  tabindex="-1"
  aria-labelledby="addCategoryModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header bg-dark">
        <h5 class="modal-title" id="addCategoryModalLabel">Add New Category</h5>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <form id="addCategoryForm">
        <div class="modal-body">
          <div class="mb-3">
            <label for="categoryName" class="form-label">Category Name</label>
            <input
              type="text"
              class="form-control custom-search-input"
              id="categoryName"
              name="name"
            />
          </div>
          <div class="mb-3">
            <label for="categoryDescription" class="form-label"
              >Description</label
            >
            <textarea
              class="form-control custom-search-input"
              id="categoryDescription"
              name="description"
            ></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            Close
          </button>
          <button type="submit" class="btn btn-primary">Add Category</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit category Modals (one for each category) -->
<% categories.forEach((category) => { %>
  <div class="modal fade" id="editCategoryModal<%= category._id %>" tabindex="-1" aria-labelledby="editCategoryModalLabel<%= category._id %>" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content bg-dark text-light">
        <div class="modal-header bg-dark text-light">
          <h5 class="modal-title" id="editcategoryModalLabel<%= category._id %>">Edit Category</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="categoryName<%= category._id %>" class="form-label">Category Name</label>
            <input
              type="text"
              class="form-control custom-search-input"
              id="categoryName<%= category._id %>"
              name="name"
              value="<%= category.name %>"         
            />
          </div>
          <div class="mb-3">
            <label for="categoryDescription<%= category._id %>" class="form-label">Description</label>
            <textarea
              class="form-control custom-search-input"
              id="categoryDescription<%= category._id %>"
              name="description"
              rows="2"
              
            ><%= category.description %></textarea>
          </div>
          <button type="button" class="btn btn-primary" onclick="handleCategoryUpdate('<%= category._id %>')">Update category</button>
        </div>
      </div>
    </div>
  </div>
<% }) %>


<script src="/js/categoryManagement.js"></script>
