<div class="container-fluid mt-3 admin-management-page">
  <div class="admin-management-header mb-3">
    <nav aria-label="breadcrumb" class="admin-breadcrumb-wrap">
      <ol class="breadcrumb admin-breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Category Management</li>
      </ol>
    </nav>
    <div class="admin-management-title-row mt-2">
      <h3 class="admin-management-title mb-0">Category Management</h3>
      <button
        type="button"
        class="btn btn-primary admin-create-btn"
        data-bs-toggle="modal"
        data-bs-target="#addCategoryModal"
      >
        Add New Category
      </button>
    </div>
  </div>

  <%- include('../partials/admin_search', {
    action: '/admin/category',
    paramName: 'search',
    value: search || '',
    placeholder: 'Search by category name or description',
    debounce: 400,
    extraQuery: { limit: pagination.limit },
  }) %>

  <%
    const attr = (value = '') =>
      String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('"', '&quot;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;');

    const categoryColumns = [
      { label: '#' },
      { label: 'Category name' },
      { label: 'Description' },
      { label: 'Action' },
    ];

    const categoryRows = categories.map((category, index) => {
      const isActive = Boolean(category.isActive);
      const toggleTitle = isActive ? 'Unlist category' : 'List category';
      const toggleClass = isActive
        ? 'admin-action-btn-danger'
        : 'admin-action-btn-success';
      const toggleIcon = isActive ? 'fa-eye-slash' : 'fa-eye';

      return {
        cells: [
          { tag: 'th', className: 'admin-row-index', text: pagination.skip + index + 1 },
          { className: 'admin-cell-primary', text: category.name },
          { text: category.description || '' },
          {
            className: 'admin-cell-actions admin-cell-actions-compact',
            html: `
              <div class="admin-action-group admin-action-group-3">
                <form
                  action="/admin/category/toggle/${category._id}"
                  method="GET"
                  class="admin-action-form"
                  data-confirm="true"
                  data-confirm-title="${isActive ? 'Unlist Category' : 'List Category'}"
                  data-confirm-message="${isActive ? 'This category will be hidden from storefront navigation.' : 'This category will be available on the storefront.'}"
                  data-confirm-text="${isActive ? 'Unlist' : 'List'}"
                  data-confirm-variant="danger"
                >
                  <input type="hidden" name="page" value="${pagination.currentPage}" />
                  <input type="hidden" name="limit" value="${pagination.limit}" />
                  <input type="hidden" name="search" value="${attr(search || '')}" />
                  <button
                    type="submit"
                    class="btn admin-action-btn admin-action-btn-icon ${toggleClass}"
                    title="${toggleTitle}"
                    aria-label="${toggleTitle}"
                  >
                    <i class="fa-solid ${toggleIcon}"></i>
                  </button>
                </form>
                <button
                  class="btn admin-action-btn admin-action-btn-icon admin-action-btn-secondary"
                  onclick="window.location.href='/admin/category/edit/${category._id}'"
                  title="Edit category"
                  aria-label="Edit category"
                >
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button
                  class="btn admin-action-btn admin-action-btn-icon admin-action-btn-danger-alt"
                  onclick="handleCategoryDelete('${category._id}')"
                  title="Delete category"
                  aria-label="Delete category"
                >
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            `,
          },
        ],
      };
    });
  %>

  <%- include('../partials/admin_table', {
    columns: categoryColumns,
    rows: categoryRows,
    tbodyId: 'categoryList',
    emptyMessage: 'No categories found',
  }) %>

  <%- include('../partials/admin_pagination', {
    pagination,
    basePath: '/admin/category',
    extraQuery: { search: search || '' },
  }) %>
</div>

<!-- Add Category Modal -->
<div
  class="modal fade"
  id="addCategoryModal"
  tabindex="-1"
  aria-labelledby="addCategoryModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header bg-dark">
        <h5 class="modal-title" id="addCategoryModalLabel">Add New Category</h5>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <form id="addCategoryForm">
        <div class="modal-body">
          <div class="mb-3">
            <label for="categoryName" class="form-label">Category Name</label>
            <input
              type="text"
              class="form-control custom-search-input"
              id="categoryName"
              name="name"
            />
          </div>
          <div class="mb-3">
            <label for="categoryDescription" class="form-label"
              >Description</label
            >
            <textarea
              class="form-control custom-search-input"
              id="categoryDescription"
              name="description"
            ></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            Close
          </button>
          <button type="submit" class="btn btn-primary">Add Category</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/categoryManagement.js"></script>
