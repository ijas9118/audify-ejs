<div class="container-fluid mt-3 admin-management-page">
  <div class="admin-management-header mb-3">
    <nav aria-label="breadcrumb" class="admin-breadcrumb-wrap">
      <ol class="breadcrumb admin-breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item"><a href="/admin/orders">Order Management</a></li>
        <li class="breadcrumb-item active" aria-current="page">#<%= order.orderId || order._id.toString().slice(-6) %></li>
      </ol>
    </nav>
    <div class="admin-management-title-row mt-2">
      <h3 class="admin-management-title mb-0">Order Details</h3>
      <a href="/admin/orders" class="btn btn-primary admin-create-btn">Back to Orders</a>
    </div>
  </div>

  <div class="admin-order-view-page">
    <% if (order.cancellationRequested) { %>
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span>
        <strong>Cancellation Requested</strong> — The customer has asked to cancel this order.
        You can approve it by setting the status to <strong>Cancelled</strong> below.
      </span>
    </div>
    <% } %>

    <section class="admin-order-section">
      <h5 class="admin-order-section-title">Overview</h5>
      <p class="admin-order-section-subtitle">Snapshot of order, customer, and current status.</p>

      <div class="admin-order-overview-grid">
        <article class="admin-order-info-card">
          <h6 class="admin-order-card-title">Order</h6>
          <dl class="admin-order-meta">
            <div>
              <dt>Order ID</dt>
              <dd><span class="admin-order-chip"><%= order.orderId || order._id %></span></dd>
            </div>
            <div>
              <dt>Date Ordered</dt>
              <dd><%= new Date(order.createdAt).toLocaleDateString() %></dd>
            </div>
            <div>
              <dt>Payment Method</dt>
              <dd><%= order.paymentMethod || 'N/A' %></dd>
            </div>
            <div>
              <dt>Status</dt>
              <dd>
                <%
                  const isTerminal = allowedNextStatuses.length === 0;
                  const statusBadgeClass =
                    order.status === 'Delivered'  ? 'is-positive' :
                    order.status === 'Cancelled'  ? 'is-negative' :
                    order.status === 'Shipped'    ? 'is-info'     :
                    order.status === 'Processed'  ? 'is-info'     : '';
                %>
                <% if (isTerminal) { %>
                  <span class="admin-status-badge <%= statusBadgeClass %>">
                    <%= order.status %>
                  </span>
                <% } else { %>
                  <div class="d-flex align-items-center gap-2">
                    <span class="admin-status-badge <%= statusBadgeClass %>">
                      <%= order.status %>
                    </span>
                    <select
                      class="form-select form-select-sm admin-status-select"
                      id="viewOrderStatus_<%= order._id %>"
                      name="status"
                      onfocus="this.dataset.previousValue=this.value"
                      onchange="updateOrderStatus('<%= order._id %>', this)"
                      style="max-width: 160px;"
                      title="Advance order status"
                    >
                      <option value="<%= order.status %>" selected><%= order.status %> (current)</option>
                      <% allowedNextStatuses.forEach(s => { %>
                        <option value="<%= s %>"><%= s %></option>
                      <% }); %>
                    </select>
                  </div>
                  <small class="text-muted d-block mt-1" style="font-size:0.75rem;">
                    Allowed: <%= allowedNextStatuses.join(' · ') %>
                  </small>
                <% } %>
              </dd>
            </div>
          </dl>
        </article>

        <article class="admin-order-info-card">
          <h6 class="admin-order-card-title">Customer</h6>
          <dl class="admin-order-meta">
            <div>
              <dt>User ID</dt>
              <dd><span class="admin-order-chip"><%= order.user._id %></span></dd>
            </div>
            <div>
              <dt>Name</dt>
              <dd><%= order.user.firstName %> <%= order.user.lastName || '' %></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><%= order.user.email %></dd>
            </div>
            <div>
              <dt>Mobile</dt>
              <dd><%= order.user.mobile || order.mobile || 'N/A' %></dd>
            </div>
          </dl>
        </article>
      </div>
    </section>

    <section class="admin-order-section">
      <h5 class="admin-order-section-title">Shipping Address</h5>
      <p class="admin-order-section-subtitle">Delivery destination captured during checkout.</p>
      <div class="admin-order-info-card admin-order-address-card">
        <p class="mb-1"><strong><%= order.name %></strong></p>
        <p class="mb-1"><%= order.location %></p>
        <p class="mb-1"><%= order.city %>, <%= order.state %> - <%= order.zip %></p>
        <% if (order.landmark) { %><p class="mb-1">Landmark: <%= order.landmark %></p><% } %>
        <p class="mb-0">Phone: <%= order.mobile %></p>
      </div>
    </section>

    <section class="admin-order-section">
      <h5 class="admin-order-section-title">Order Items</h5>
      <p class="admin-order-section-subtitle">Line-item breakdown for purchased products.</p>
      <div class="admin-table-shell">
        <div class="table-responsive">
          <table class="table admin-management-table align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">Product</th>
                <th scope="col">Quantity</th>
                <th scope="col">Price (Each)</th>
                <th scope="col">Total Price</th>
              </tr>
            </thead>
            <tbody>
              <% order.orderItems.forEach((item) => { %>
              <tr>
                <td class="admin-cell-primary"><%= item.product.name %></td>
                <td><%= item.quantity %></td>
                <td>₹<%= item.product.price.toFixed(2) %></td>
                <td>₹<%= (item.product.price * item.quantity).toFixed(2) %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="admin-order-section">
      <h5 class="admin-order-section-title">Order Summary</h5>
      <p class="admin-order-section-subtitle">Final payable totals after shipping and discounts.</p>
      <div class="admin-order-summary-list">
        <div class="admin-order-summary-row">
          <span>Total Amount</span>
          <strong>₹<%= order.totalAmount.toFixed(2) %></strong>
        </div>
        <div class="admin-order-summary-row">
          <span>Shipping Charge</span>
          <strong>₹<%= order.shippingCharge.toFixed(2) %></strong>
        </div>
        <div class="admin-order-summary-row">
          <span>Discount Applied</span>
          <strong>₹<%= order.discountApplied.toFixed(2) %></strong>
        </div>
        <div class="admin-order-summary-row is-total">
          <span>Final Total</span>
          <strong>₹<%= order.finalTotal.toFixed(2) %></strong>
        </div>
      </div>
    </section>
  </div>
</div>

<script src="/js/orderManagement.js"></script>
