<%
  const data = formData || coupon || {};
  const errorsMap = errors || {};
  const fieldError = (name) => errorsMap[name] || '';
  const fieldClass = (name) => (fieldError(name) ? 'is-invalid' : '');
  const valueOf = (name, fallback = '') =>
    data[name] !== undefined && data[name] !== null ? data[name] : fallback;
  const formatDateInput = (value) => {
    if (!value) return '';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    return date.toISOString().split('T')[0];
  };
  const couponCodeLabel = (valueOf('code', '') || 'Coupon').toString().toUpperCase();
%>

<div class="container-fluid mt-3 admin-management-page">
  <div class="admin-management-header mb-3">
    <nav aria-label="breadcrumb" class="admin-breadcrumb-wrap">
      <ol class="breadcrumb admin-breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item"><a href="/admin/coupons">Coupon Management</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= couponCodeLabel %></li>
      </ol>
    </nav>
    <div class="admin-management-title-row mt-2">
      <h3 class="admin-management-title mb-0">Edit Coupon</h3>
      <a href="/admin/coupons" class="btn btn-primary admin-create-btn">
        Back to Coupons
      </a>
    </div>
  </div>

  <div class="admin-coupon-edit-page">
    <% if (formError) { %>
    <div class="alert alert-danger mb-3" role="alert"><%= formError %></div>
    <% } %>

    <form
      action="/admin/coupons/edit/<%= coupon._id %>"
      method="POST"
      class="admin-coupon-form"
      id="editCouponForm"
      novalidate
    >
      <div class="admin-coupon-form-grid">
        <section class="admin-coupon-form-section">
          <h5 class="admin-coupon-form-title">Identity</h5>
          <p class="admin-coupon-form-subtitle">Core coupon settings and availability.</p>

          <div class="row g-3">
            <div class="col-md-6">
              <label for="code" class="form-label">Coupon Code</label>
              <input
                type="text"
                class="form-control custom-search-input admin-coupon-input <%= fieldClass('code') %>"
                id="code"
                name="code"
                value="<%= valueOf('code', '') %>"
                maxlength="20"
                required
              />
              <div class="invalid-feedback"><%= fieldError('code') || 'Coupon code is required.' %></div>
            </div>

            <div class="col-md-6">
              <label for="isActive" class="form-label">Coupon Status</label>
              <select class="form-select admin-coupon-select" id="isActive" name="isActive">
                <option value="true" <%= String(valueOf('isActive', true)) === 'true' ? 'selected' : '' %>>
                  Active
                </option>
                <option value="false" <%= String(valueOf('isActive', true)) === 'false' ? 'selected' : '' %>>
                  Inactive
                </option>
              </select>
            </div>

            <div class="col-md-6">
              <label for="validFrom" class="form-label">Valid From</label>
              <input
                type="date"
                class="form-control custom-search-input admin-coupon-input <%= fieldClass('validFrom') %>"
                id="validFrom"
                name="validFrom"
                value="<%= formatDateInput(valueOf('validFrom', '')) %>"
                required
              />
              <div class="invalid-feedback"><%= fieldError('validFrom') || 'Valid from date is required.' %></div>
            </div>

            <div class="col-md-6">
              <label for="validUntil" class="form-label">Valid Until</label>
              <input
                type="date"
                class="form-control custom-search-input admin-coupon-input <%= fieldClass('validUntil') %>"
                id="validUntil"
                name="validUntil"
                value="<%= formatDateInput(valueOf('validUntil', '')) %>"
                required
              />
              <div class="invalid-feedback"><%= fieldError('validUntil') || 'Valid until date is required.' %></div>
            </div>
          </div>
        </section>

        <section class="admin-coupon-form-section">
          <h5 class="admin-coupon-form-title">Discount Rules</h5>
          <p class="admin-coupon-form-subtitle">Control value, limits, and per-user policy.</p>

          <div class="row g-3">
            <div class="col-md-6">
              <label for="discountType" class="form-label">Discount Type</label>
              <select
                class="form-select admin-coupon-select <%= fieldClass('discountType') %>"
                id="discountType"
                name="discountType"
                required
              >
                <option value="percentage" <%= valueOf('discountType', 'percentage') === 'percentage' ? 'selected' : '' %>>
                  Percentage
                </option>
                <option value="fixed" <%= valueOf('discountType') === 'fixed' ? 'selected' : '' %>>
                  Fixed Amount
                </option>
              </select>
              <div class="invalid-feedback"><%= fieldError('discountType') || 'Discount type is required.' %></div>
            </div>

            <div class="col-md-6">
              <label for="discountValue" class="form-label">Discount Value</label>
              <input
                type="number"
                class="form-control custom-search-input admin-coupon-input <%= fieldClass('discountValue') %>"
                id="discountValue"
                name="discountValue"
                value="<%= valueOf('discountValue', '') %>"
                min="0.01"
                step="0.01"
                required
              />
              <div class="invalid-feedback"><%= fieldError('discountValue') || 'Discount value must be greater than 0.' %></div>
            </div>

            <div class="col-md-6">
              <label for="maxDiscountValue" class="form-label">Max Discount Value</label>
              <input
                type="number"
                class="form-control custom-search-input admin-coupon-input <%= fieldClass('maxDiscountValue') %>"
                id="maxDiscountValue"
                name="maxDiscountValue"
                value="<%= valueOf('maxDiscountValue', '') %>"
                min="0"
                step="0.01"
              />
              <div class="invalid-feedback"><%= fieldError('maxDiscountValue') || 'Maximum discount must be a non-negative number.' %></div>
            </div>

            <div class="col-md-6">
              <label for="minCartValue" class="form-label">Minimum Cart Subtotal</label>
              <input
                type="number"
                class="form-control custom-search-input admin-coupon-input <%= fieldClass('minCartValue') %>"
                id="minCartValue"
                name="minCartValue"
                value="<%= valueOf('minCartValue', 0) %>"
                min="0"
                step="0.01"
              />
              <div class="invalid-feedback"><%= fieldError('minCartValue') || 'Minimum cart subtotal must be a non-negative number.' %></div>
            </div>

            <div class="col-md-6">
              <label for="usageLimit" class="form-label">Usage Limit Per User</label>
              <input
                type="number"
                class="form-control custom-search-input admin-coupon-input <%= fieldClass('usageLimit') %>"
                id="usageLimit"
                name="usageLimit"
                value="<%= valueOf('usageLimit', 1) %>"
                min="1"
                step="1"
              />
              <div class="invalid-feedback"><%= fieldError('usageLimit') || 'Usage limit must be at least 1.' %></div>
            </div>
          </div>
        </section>
      </div>

      <div class="admin-coupon-actionbar">
        <a href="/admin/coupons" class="btn admin-action-btn admin-action-btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary admin-create-btn">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  (() => {
    const form = document.getElementById('editCouponForm');
    if (!form) {
      return;
    }

    form.addEventListener('submit', (event) => {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    });
  })();
</script>
