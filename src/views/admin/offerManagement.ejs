<div class="container-fluid mt-3 admin-management-page">
  <div class="admin-management-header mb-3">
    <nav aria-label="breadcrumb" class="admin-breadcrumb-wrap">
      <ol class="breadcrumb admin-breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/admin">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Offer Management</li>
      </ol>
    </nav>
    <div class="admin-management-title-row mt-2">
      <h3 class="admin-management-title mb-0">Manage Offers</h3>
      <button
        type="button"
        class="btn btn-primary admin-create-btn"
        data-bs-toggle="modal"
        data-bs-target="#addOfferModal"
      >
        Add New Offer
      </button>
    </div>
  </div>

  <%- include('../partials/admin_search', {
    action: '/admin/offers',
    paramName: 'search',
    value: search || '',
    placeholder: 'Search by type, status, discount, product or category',
    debounce: 400,
    extraQuery: { limit: pagination.limit },
  }) %>

  <%
    const offerColumns = [
      { label: '#' },
      { label: 'Offer Type' },
      { label: 'Applicable To' },
      { label: 'Discount' },
      { label: 'Max Discount' },
      { label: 'Valid From' },
      { label: 'Valid Until' },
      { label: 'Status' },
      { label: 'Actions' },
    ];

    const offerRows = offers.map((offer, index) => {
      let applicableTo = '-';
      if (offer.type === 'product') {
        applicableTo = offer.product && offer.product.name ? offer.product.name : '-';
      } else if (offer.type === 'category') {
        applicableTo = offer.category && offer.category.name ? offer.category.name : '-';
      }

      return {
        dataAttrs: { 'offer-id': offer._id },
        cells: [
          { tag: 'th', className: 'admin-row-index', text: pagination.skip + index + 1 },
          { className: 'admin-cell-primary', text: offer.type },
          { text: applicableTo },
          {
            text:
              offer.discountType === 'percentage'
                ? `${offer.discountValue}%`
                : `₹${offer.discountValue}`,
          },
          { text: offer.maxDiscountAmount ? `₹${offer.maxDiscountAmount}` : '-' },
          { text: new Date(offer.validFrom).toLocaleDateString() },
          { text: new Date(offer.validUntil).toLocaleDateString() },
          {
            html: `
              <span
                id="statusDisplay${offer._id}"
                class="admin-status-badge ${offer.status === 'active' ? 'is-positive' : 'is-negative'}"
                onclick="toggleOfferStatus('${offer._id}')"
              >
                ${offer.status}
              </span>
            `,
          },
          {
            className: 'admin-cell-actions admin-cell-actions-compact',
            html: `
              <div class="admin-action-group">
                <button
                  class="btn admin-action-btn admin-action-btn-icon admin-action-btn-secondary"
                  onclick="window.location.href='/admin/offers/edit/${offer._id}'"
                  title="Edit offer"
                  aria-label="Edit offer"
                >
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button
                  class="btn admin-action-btn admin-action-btn-icon admin-action-btn-danger-alt"
                  onclick="deleteOffer('${offer._id}')"
                  title="Delete offer"
                  aria-label="Delete offer"
                >
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            `,
          },
        ],
      };
    });
  %>

  <%- include('../partials/admin_table', {
    columns: offerColumns,
    rows: offerRows,
    emptyMessage: 'No offers found',
  }) %>

  <%- include('../partials/admin_pagination', {
    pagination,
    basePath: '/admin/offers',
    extraQuery: { search: search || '' },
  }) %>
</div>

<!-- Bootstrap Modal for Adding Offer -->
<div
  class="modal fade admin-confirm-modal"
  id="addOfferModal"
  tabindex="-1"
  aria-labelledby="addOfferModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-xl modal-dialog-centered admin-form-modal">
    <div class="modal-content admin-form-modal-content admin-confirm-content">
      <div class="modal-header admin-form-modal-header admin-confirm-header">
        <div>
          <h5 class="admin-form-modal-title admin-confirm-title" id="addOfferModalLabel">
            Add New Offer
          </h5>
          <p class="admin-form-modal-subtitle mb-0">
            Configure offer scope, discount strategy, and validity window.
          </p>
        </div>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <form id="addOfferForm" novalidate>
        <div class="modal-body admin-form-modal-body">
          <div class="admin-coupon-form-grid">
            <section class="admin-coupon-form-section pt-0">
              <h5 class="admin-coupon-form-title">Offer Scope</h5>
              <p class="admin-coupon-form-subtitle">Choose where this offer should be applied.</p>

              <div class="row g-3">
                <div class="col-md-6">
                  <label for="offerType" class="form-label">Offer Type</label>
                  <select class="form-select admin-coupon-select" id="offerType" required>
                    <option value="" selected>Select Offer Type</option>
                    <option value="product">Product</option>
                    <option value="category">Category</option>
                  </select>
                </div>

                <div id="productCategorySection" class="col-md-6" style="display: none;">
                  <label for="productOrCategory" class="form-label">Select Product/Category</label>
                  <select class="form-select admin-coupon-select" id="productOrCategory" required>
                    <option value="" selected>Select Product or Category</option>
                  </select>
                </div>
              </div>
            </section>

            <section class="admin-coupon-form-section">
              <h5 class="admin-coupon-form-title">Discount Rules</h5>
              <p class="admin-coupon-form-subtitle">Define discount type, amount, and caps.</p>

              <div class="row g-3">
                <div class="col-md-6">
                  <label for="discountType" class="form-label">Discount Type</label>
                  <select class="form-select admin-coupon-select" id="discountType" required>
                    <option value="" selected>Select Discount Type</option>
                    <option value="percentage">Percentage</option>
                    <option value="fixed">Fixed Amount</option>
                  </select>
                </div>

                <div class="col-md-6">
                  <label for="discountValue" class="form-label">Discount Value</label>
                  <input
                    type="number"
                    class="form-control custom-search-input admin-coupon-input"
                    id="discountValue"
                    placeholder="Enter Discount Value"
                    min="0.01"
                    step="0.01"
                    required
                  />
                  <div class="form-text admin-form-helptext" id="discountValueHintModal">
                    Enter a positive value.
                  </div>
                </div>

                <div class="col-md-6">
                  <label for="maxDiscountAmount" class="form-label">Max Discount Amount</label>
                  <input
                    type="number"
                    class="form-control custom-search-input admin-coupon-input"
                    id="maxDiscountAmount"
                    placeholder="Enter Max Discount Amount"
                    min="0"
                    step="0.01"
                  />
                </div>
              </div>
            </section>

            <section class="admin-coupon-form-section">
              <h5 class="admin-coupon-form-title">Validity</h5>
              <p class="admin-coupon-form-subtitle">Set activation and expiry dates.</p>

              <div class="row g-3">
                <div class="col-md-6">
                  <label for="validFrom" class="form-label">Valid From</label>
                  <input
                    type="date"
                    class="form-control custom-search-input admin-coupon-input"
                    id="validFrom"
                    required
                  />
                </div>
                <div class="col-md-6">
                  <label for="validUntil" class="form-label">Valid Until</label>
                  <input
                    type="date"
                    class="form-control custom-search-input admin-coupon-input"
                    id="validUntil"
                    required
                  />
                </div>
              </div>
            </section>
          </div>
        </div>

        <div class="modal-footer admin-form-modal-footer admin-confirm-footer">
          <button
            type="button"
            class="btn admin-action-btn admin-action-btn-secondary"
            data-bs-dismiss="modal"
          >
            Cancel
          </button>
          <button type="submit" class="btn btn-primary admin-create-btn">Add Offer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/offerManagement.js"></script>
