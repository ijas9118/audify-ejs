<div
  class="modal fade admin-confirm-modal"
  id="adminConfirmModal"
  tabindex="-1"
  aria-labelledby="adminConfirmModalTitle"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content admin-confirm-content">
      <div class="modal-header admin-confirm-header">
        <h5 class="admin-confirm-title" id="adminConfirmModalTitle">Confirm Action</h5>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body admin-confirm-body">
        <p id="adminConfirmModalMessage" class="mb-0">
          Are you sure you want to continue?
        </p>
      </div>
      <div class="modal-footer admin-confirm-footer">
        <button type="button" class="btn admin-action-btn admin-action-btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="button" id="adminConfirmModalSubmit" class="btn admin-action-btn admin-action-btn-danger">
          Confirm
        </button>
      </div>
    </div>
  </div>
</div>
