<%
  const query = extraQuery || {};

  const buildUrl = (pageValue, limitValue) => {
    const params = new URLSearchParams();

    Object.entries(query).forEach(([key, value]) => {
      if (value !== undefined && value !== null && value !== '') {
        params.set(key, value);
      }
    });

    params.set('page', String(pageValue));
    params.set('limit', String(limitValue));

    return `${basePath}?${params.toString()}`;
  };

  const hasPrev = pagination.currentPage > 1;
  const hasNext = pagination.currentPage < pagination.totalPages;
%>

<div class="admin-pagination-wrap my-4" data-bs-theme="dark">
  <form method="GET" action="<%= basePath %>" class="admin-limit-form">
    <% Object.entries(query).forEach(([key, value]) => { %>
      <% if (value !== undefined && value !== null && value !== '') { %>
        <input type="hidden" name="<%= key %>" value="<%= value %>" />
      <% } %>
    <% }); %>
    <input type="hidden" name="page" value="1" />
    <label for="pagination-limit" class="admin-limit-label">Per page</label>
    <select
      id="pagination-limit"
      class="form-select form-select-sm admin-limit-select"
      name="limit"
      onchange="this.form.submit()"
    >
      <% pagination.limitOptions.forEach((option) => { %>
        <option value="<%= option %>" <%= option === pagination.limit ? 'selected' : '' %>>
          <%= option %>
        </option>
      <% }); %>
    </select>
  </form>

  <nav aria-label="Admin pagination" class="admin-pagination-nav">
    <ul class="pagination pagination-sm mb-0 admin-pagination-list">
      <li class="page-item <%= hasPrev ? '' : 'disabled' %>">
        <a
          class="page-link"
          href="<%= hasPrev ? buildUrl(pagination.currentPage - 1, pagination.limit) : '#' %>"
          aria-disabled="<%= hasPrev ? 'false' : 'true' %>"
          tabindex="<%= hasPrev ? '0' : '-1' %>"
        >
          Prev
        </a>
      </li>

      <% pagination.pageItems.forEach((item) => { %>
        <% if (item === 'ellipsis') { %>
          <li class="page-item disabled"><span class="page-link">...</span></li>
        <% } else { %>
          <li class="page-item <%= item === pagination.currentPage ? 'active' : '' %>">
            <a class="page-link" href="<%= buildUrl(item, pagination.limit) %>"><%= item %></a>
          </li>
        <% } %>
      <% }); %>

      <li class="page-item <%= hasNext ? '' : 'disabled' %>">
        <a
          class="page-link"
          href="<%= hasNext ? buildUrl(pagination.currentPage + 1, pagination.limit) : '#' %>"
          aria-disabled="<%= hasNext ? 'false' : 'true' %>"
          tabindex="<%= hasNext ? '0' : '-1' %>"
        >
          Next
        </a>
      </li>
    </ul>
  </nav>
</div>
