<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/error-pages.css" />
  </head>
  <body class="error-page">
    <main class="error-shell">
      <section class="error-card" role="alert" aria-live="polite">
        <p class="error-code">500</p>
        <h1 class="error-title">Unexpected server error</h1>
        <p class="error-description">
          We could not complete this request. Please try again in a moment.
        </p>

        <% if (errorMessage) { %>
        <p class="error-meta"><%= errorMessage %></p>
        <% } %>

        <% if (stack) { %>
        <details class="error-details">
          <summary><i class="fas fa-bug me-1"></i> Technical details</summary>
          <pre><%= stack %></pre>
        </details>
        <% } %>

        <div class="error-actions">
          <a href="/" class="error-btn error-btn-primary">
            <i class="fas fa-home me-2"></i> Back to Homepage
          </a>
          <button type="button" class="error-btn error-btn-secondary" onclick="location.reload()">
            <i class="fas fa-redo me-2"></i> Try Again
          </button>
        </div>
      </section>
    </main>
  </body>
</html>
